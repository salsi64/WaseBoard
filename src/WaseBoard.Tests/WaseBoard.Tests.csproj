<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests de la logique pure du client (sans WPF) : les fichiers concernés sont compilés tels quels depuis
       src/WaseBoard plutôt que référencés par le projet de l'application (publication auto-contenue en fichier
       unique : mauvaise cible pour une référence de test). Lancer : dotnet test src/WaseBoard.Tests -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>WaseBoard.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\WaseBoard\AppIdentity.cs" Link="Linked\AppIdentity.cs" />
    <Compile Include="..\WaseBoard\Services\LatencyRecorder.cs" Link="Linked\LatencyRecorder.cs" />
    <Compile Include="..\WaseBoard\Services\BeepTone.cs" Link="Linked\BeepTone.cs" />
    <Compile Include="..\WaseBoard\Services\ClipRingBuffer.cs" Link="Linked\ClipRingBuffer.cs" />
    <Compile Include="..\WaseBoard\Services\CategoryMirror.cs" Link="Linked\CategoryMirror.cs" />
    <Compile Include="..\WaseBoard\Services\PcmTools.cs" Link="Linked\PcmTools.cs" />
    <Compile Include="..\WaseBoard\Services\Localization\Loc.cs" Link="Linked\Loc.cs" />
    <EmbeddedResource Include="..\WaseBoard\Localization\*.json" LogicalName="Localization.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
