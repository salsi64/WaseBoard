<Window x:Class="WaseBoard.Windows.TrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:WaseBoard.Windows.Chrome"
        xmlns:local="clr-namespace:WaseBoard.Windows"
        Title="Éditer le son"
        FontFamily="Segoe UI Emoji, Segoe UI" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBrush}"
        chrome:WindowChromeBehavior.Enable="True"
        ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Display"
        Closing="Window_Closing">
    <Window.Resources>
        <!-- Libellé de section en petites capitales façon éditeur audio -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <!-- Champ « en creux » : plus sombre que la fenêtre -->
        <Style x:Key="FlatField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>
        <!-- Petit bouton carré (− / + / ↺ / 🔊) -->
        <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TrackBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <!-- Pastille de valeur (100 %, 0.0s – 3.8s) -->
        <Style x:Key="ValueChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TrackBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="9,3"/>
        </Style>
        <!-- Pastille de couleur ronde : anneau clair + ✓ quand elle est choisie -->
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2.5"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Curseur de volume : piste fine, repère à 100 %, poignée en dégradé d'accent -->
        <Style x:Key="FlatSlider" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="{TemplateBinding Height}">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource TrackBrush}"/>
                            <Border Width="2" Height="10" HorizontalAlignment="Center" Background="{DynamicResource TrackBrush}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate><Border Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate><Border Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource AccentGradientBrush}" Stroke="{DynamicResource PanelBrush}" StrokeThickness="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootChromeBorder" CornerRadius="8" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource TrackBrush}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <chrome:TitleBarControl x:Name="ChromeTitleBar" Grid.Row="0" TitleText="" ShowMinMax="False"/>
        <TextBlock x:Name="HeadingText" Grid.Row="0" Text="Éditer le son" FontSize="16" FontWeight="Bold" Margin="22,2,0,0"
                   VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" Foreground="{DynamicResource TextBrush}"/>

        <StackPanel Grid.Row="1" Margin="22,6,22,22">

            <!-- Vignette (emoji + favori) et nom -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="76" Height="76" VerticalAlignment="Top">
                    <Button x:Name="ThumbButton" Width="68" Height="68" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Background="{DynamicResource AccentGradientBrush}"
                            Click="ThumbButton_Click" Cursor="Hand" ToolTip="Choisir un emoji">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="20" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <Image x:Name="EmojiPreview" Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="EmojiPlaceholder" Text="＋" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource OnAccentBrush}" Opacity="0.7"/>
                        </Grid>
                    </Button>
                    <Button x:Name="FavoriteButton" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Click="FavoriteButton_Click" Cursor="Hand" ToolTip="Favori" Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="12" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource TrackBrush}" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="FavoriteGlyph" Text="☆" FontSize="13" Foreground="{DynamicResource TextBrush}" Opacity="0.7"/>
                    </Button>
                    <Border Width="22" Height="22" CornerRadius="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False"
                            Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource TrackBrush}" BorderThickness="1">
                        <TextBlock Text="✏" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="NOM" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource FlatField}" VerticalContentAlignment="Center" TextChanged="NameBox_TextChanged"/>
                </StackPanel>
            </Grid>

            <!-- Sections propres à un son existant : couleur, catégories et volume (masquées à l'ajout) -->
            <StackPanel x:Name="EditOnlyPanel" Visibility="Collapsed">
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="COULEUR" Style="{StaticResource FieldLabel}"/>
                    <WrapPanel x:Name="SwatchPanel"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="CATÉGORIES" Style="{StaticResource FieldLabel}"/>
                    <Button x:Name="CategoryTrigger" Click="CategoryTrigger_Click" Height="38" Padding="12,0"
                            HorizontalContentAlignment="Stretch" Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
                            BorderBrush="{DynamicResource TrackBrush}" BorderThickness="1">
                        <Grid>
                            <TextBlock x:Name="CategoryTriggerText" Text="Aucune" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBlock Text="▾" Opacity="0.55" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </Button>
                    <Popup x:Name="CategoryPopup" PlacementTarget="{Binding ElementName=CategoryTrigger}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="CategoryPopup_Closed">
                        <Border Margin="0,6,16,16" Width="376" Background="{DynamicResource BgBrush}"
                                BorderBrush="{DynamicResource TrackBrush}" BorderThickness="1" CornerRadius="14" Padding="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel>
                                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="CategoryList"/>
                                </ScrollViewer>
                                <Border BorderBrush="{DynamicResource TrackBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,6,0,0">
                                    <StackPanel>
                                        <Button x:Name="NewCategoryButton" Content="+ Nouvelle catégorie" Click="NewCategoryButton_Click"
                                                HorizontalContentAlignment="Left" Padding="10,7" Background="Transparent" BorderThickness="0"
                                                Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                        <Grid x:Name="NewCategoryRow" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="NewCategoryBox" Height="32" KeyDown="NewCategoryBox_KeyDown"/>
                                            <Button Grid.Column="1" Content="✓" Width="32" Height="32" Margin="6,0,0,0" Padding="0" Click="NewCategoryConfirm_Click"
                                                    Background="{DynamicResource AccentGradientBrush}" Foreground="{DynamicResource OnAccentBrush}" BorderThickness="0"/>
                                            <Button Grid.Column="2" Content="✕" Width="32" Height="32" Margin="6,0,0,0" Padding="0" Click="NewCategoryCancel_Click"
                                                    Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <StackPanel Margin="0,0,0,18">
                    <Grid Margin="0,0,0,7">
                        <TextBlock Text="VOLUME" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ResetVolumeButton" Content="↺" Style="{StaticResource StepButton}" Width="26" Height="26" Margin="0,0,8,0"
                                    ToolTip="Revenir à 100 %" Click="ResetVolume_Click" Visibility="Hidden"/>
                            <Border Style="{StaticResource ValueChip}">
                                <TextBlock x:Name="VolumeChip" Text="100%" FontSize="12" Foreground="{DynamicResource TextBrush}" Opacity="0.85"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="−" Style="{StaticResource StepButton}" ToolTip="Réduire" Click="VolumeMinus_Click"/>
                        <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource FlatSlider}" Minimum="0" Maximum="200" Value="100"
                                SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" Margin="12,0"
                                VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                        <Button Grid.Column="2" Content="+" Style="{StaticResource StepButton}" ToolTip="Amplifier" Click="VolumePlus_Click"/>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- Découpe -->
            <Grid Margin="0,0,0,7">
                <TextBlock Text="DÉCOUPE" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Style="{StaticResource ValueChip}" Margin="0,0,8,0">
                        <TextBlock x:Name="TimeLabel" FontSize="12" Foreground="{DynamicResource TextBrush}" Opacity="0.85" Text="0.0s – 0.0s"/>
                    </Border>
                    <Button x:Name="MuteButton" Content="🔊" Style="{StaticResource StepButton}" Width="28" Height="28" FontSize="12"
                            ToolTip="Couper le son de l'aperçu" Click="MuteButton_Click"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="LoadingText" Text="Analyse du fichier audio..."
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>

            <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource TrackBrush}" BorderThickness="1"
                    CornerRadius="12" Height="60" Margin="0,0,0,10" ClipToBounds="True">
                <Canvas x:Name="WaveformCanvas" Width="374" Height="58" ClipToBounds="True">
                    <!-- Zone gardée : teinte d'accent + liseré à chaque bord -->
                    <Rectangle x:Name="SelectionRect" Height="58" Canvas.Top="0" Fill="{DynamicResource AccentBrush}" Opacity="0.14"/>
                    <Rectangle x:Name="SelectionStartLine" Width="2" Height="58" Canvas.Top="0" Fill="{DynamicResource AccentBrush}"/>
                    <Rectangle x:Name="SelectionEndLine" Width="2" Height="58" Canvas.Top="0" Fill="{DynamicResource Accent2Brush}"/>

                    <!-- Poignées : capsule claire, zone de saisie élargie -->
                    <Thumb x:Name="StartHandle" Width="14" Height="58" Canvas.Top="0"
                           DragDelta="StartHandle_DragDelta" DragCompleted="Handle_DragCompleted" Cursor="SizeWE">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent" Width="14" Height="58">
                                    <Border Width="4" Height="26" CornerRadius="2" Background="{DynamicResource TextBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    <Thumb x:Name="EndHandle" Width="14" Height="58" Canvas.Top="0"
                           DragDelta="EndHandle_DragDelta" DragCompleted="Handle_DragCompleted" Cursor="SizeWE">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent" Width="14" Height="58">
                                    <Border Width="4" Height="26" CornerRadius="2" Background="{DynamicResource TextBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Canvas>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <Button x:Name="PreviewButton" Content="▶  Écouter l'extrait" Padding="14,8" Margin="0,0,8,0"
                        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="1"
                        BorderBrush="{DynamicResource TrackBrush}" Click="PreviewButton_Click"/>
                <Button x:Name="ResetButton" Content="Tout garder" Padding="14,8"
                        Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="1"
                        BorderBrush="{DynamicResource TrackBrush}" Click="ResetButton_Click"/>
            </StackPanel>

            <TextBlock x:Name="HintText" Foreground="{DynamicResource TextBrush}" Opacity="0.55" FontSize="11" Margin="0,-8,0,16" TextWrapping="Wrap"
                       Text="Faites glisser les poignées pour ne garder qu'une partie. Le son complet est conservé : vous pourrez le modifier plus tard (clic droit › Éditer)."/>

            <!-- Fichier du son (mode édition) -->
            <StackPanel x:Name="FilePanel" Visibility="Collapsed" Margin="0,0,0,4">
                <TextBlock Text="SON" Style="{StaticResource FieldLabel}"/>
                <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource TrackBrush}" BorderThickness="1" CornerRadius="12" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource PanelBrush}">
                            <TextBlock Text="🎵" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                            <TextBlock x:Name="FileNameText" FontSize="13.5" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="FileInfoText" FontSize="11.5" Opacity="0.5" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                        <Button x:Name="ReplaceFileButton" Grid.Column="2" Content="Remplacer…" Padding="12,6" FontSize="12" Margin="0,0,4,0"
                                VerticalAlignment="Center" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
                                BorderBrush="{DynamicResource TrackBrush}" BorderThickness="1" Click="ReplaceFileButton_Click"
                                ToolTip="Remplacer le fichier audio par un autre : le son garde son nom, son emoji, ses catégories et ses réglages"/>
                        <Button x:Name="RevertFileButton" Grid.Column="3" Content="↩" Width="30" Height="30" Padding="0" Margin="0,0,2,0" Visibility="Collapsed"
                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" Opacity="0.8"
                                ToolTip="Garder le fichier actuel" Click="RevertFileButton_Click"/>
                        <Button Grid.Column="4" Content="🗑" Width="30" Height="30" Padding="0" Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource TextBrush}" Opacity="0.6" ToolTip="Supprimer ce son" Click="DeleteButton_Click"/>
                    </Grid>
                </Border>
            </StackPanel>

            <Grid Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuler" Padding="20,10" Margin="0,0,10,0" Click="Cancel_Click"
                            Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
                            BorderBrush="{DynamicResource TrackBrush}" BorderThickness="1" FontWeight="SemiBold"/>
                    <Button x:Name="ConfirmButton" Content="Ajouter le son" Padding="22,10" Click="Confirm_Click" FontWeight="Bold"
                            Background="{DynamicResource AccentGradientBrush}" Foreground="{DynamicResource OnAccentBrush}" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Sélecteur d'emoji : s'ouvre sous la vignette (le champ texte reste là pour coller un emoji) -->
        <Popup x:Name="EmojiPopup" PlacementTarget="{Binding ElementName=ThumbButton}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="EmojiPopup_Closed">
            <Border Margin="0,6,16,16" Width="340" Background="{DynamicResource BgBrush}"
                    BorderBrush="{DynamicResource TrackBrush}" BorderThickness="1" CornerRadius="14" Padding="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBox x:Name="EmojiBox" Height="32" FontSize="15" HorizontalContentAlignment="Left" Margin="0,0,0,8"
                             FontFamily="Segoe UI Emoji, Segoe UI" TextChanged="EmojiBox_TextChanged"
                             ToolTip="Choisissez dans la grille ci-dessous, ou collez un emoji"/>
                    <local:EmojiPaletteControl x:Name="Palette" Height="170"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
    </Border>
</Window>
