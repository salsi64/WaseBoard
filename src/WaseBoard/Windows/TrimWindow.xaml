<Window x:Class="WaseBoard.Windows.TrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:WaseBoard.Windows.Chrome"
        Title="Découper le son"
        FontFamily="Segoe UI Emoji, Segoe UI" Height="360" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        chrome:WindowChromeBehavior.Enable="True"
        ResizeMode="NoResize"
        Closing="Window_Closing">
    <Border x:Name="RootChromeBorder" CornerRadius="8" Background="{DynamicResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <chrome:TitleBarControl Grid.Row="0" TitleText="Découper le son" ShowMinMax="False"/>
        <Grid Grid.Row="1" Margin="20,4,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Nom du son :" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="NameBox" Width="300" Height="26"/>
        </StackPanel>

        <TextBlock x:Name="LoadingText" Grid.Row="1" Text="Analyse du fichier audio..."
                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>

        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="6" Height="150" Margin="0,0,0,4">
            <Canvas x:Name="WaveformCanvas" Width="736" Height="150" ClipToBounds="True">
                <!-- Zones grisées avant/après la sélection -->
                <Rectangle x:Name="LeftMaskRect" Fill="#99000000" Height="150" Canvas.Top="0"/>
                <Rectangle x:Name="RightMaskRect" Fill="#99000000" Height="150" Canvas.Top="0"/>

                <!-- Poignées de découpe -->
                <Thumb x:Name="StartHandle" Width="10" Height="150" Canvas.Top="0" Background="#7C5CFF"
                       DragDelta="StartHandle_DragDelta" Cursor="SizeWE">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Rectangle Fill="#7C5CFF" Width="10" Height="150"/>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
                <Thumb x:Name="EndHandle" Width="10" Height="150" Canvas.Top="0" Background="#7C5CFF"
                       DragDelta="EndHandle_DragDelta" Cursor="SizeWE">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Rectangle Fill="#7C5CFF" Width="10" Height="150"/>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Canvas>
        </Border>

        <TextBlock x:Name="TimeLabel" Grid.Row="3" Foreground="{DynamicResource TextBrush}" Opacity="0.8"
                   FontSize="12" Margin="0,4,0,16" Text="Début : 0:00 — Fin : 0:00 — Durée sélectionnée : 0:00"/>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <Button x:Name="PreviewButton" Content="▶ Aperçu" Padding="14,8" Margin="0,0,8,0"
                        Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="1"
                        BorderBrush="{DynamicResource TextBrush}" Click="PreviewButton_Click"/>
                <Button x:Name="ResetButton" Content="Tout garder" Padding="14,8"
                        Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="1"
                        BorderBrush="{DynamicResource TextBrush}" Click="ResetButton_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Column="1">
                <Button Content="Annuler" Padding="14,8" Margin="0,0,8,0" Click="Cancel_Click"
                        Background="Transparent" Foreground="{DynamicResource TextBrush}"/>
                <Button x:Name="ConfirmButton" Content="Ajouter le son" Padding="18,8" Click="Confirm_Click"
                        Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
        </Grid>
    </Grid>
    </Border>
</Window>
