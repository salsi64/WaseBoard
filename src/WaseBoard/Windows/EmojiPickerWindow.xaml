<Window x:Class="WaseBoard.Windows.EmojiPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:WaseBoard.Services.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:WaseBoard.Windows.Chrome"
        xmlns:local="clr-namespace:WaseBoard.Windows"
        Title="{loc:Loc emoji.title}"
        FontFamily="Segoe UI Emoji, Segoe UI" Height="420" Width="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        chrome:WindowChromeBehavior.Enable="True"
        ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Display">
    <Border x:Name="RootChromeBorder" CornerRadius="8" Background="{DynamicResource SurfaceBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <chrome:TitleBarControl Grid.Row="0" TitleText="{loc:Loc emoji.title}" ShowMinMax="False"/>
            <StackPanel Grid.Row="1" Margin="16,4,16,16">
                <TextBlock x:Name="IntroText" Text="{loc:Loc emoji.for_sound}" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>

                <local:EmojiPaletteControl x:Name="Palette" MaxHeight="220" Margin="0,0,0,12"/>

                <TextBlock Text="{loc:Loc emoji.paste_custom}" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="CustomEmojiBox" Height="30" FontSize="16" Margin="0,0,0,14"
                         FontFamily="Segoe UI Emoji, Segoe UI"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RemoveButton" Content="{loc:Loc emoji.remove}" Padding="10,6" Margin="0,0,8,0" Click="Remove_Click"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button x:Name="CancelButton" Content="{loc:Loc common.cancel}" Padding="10,6" Margin="0,0,8,0" Click="Cancel_Click"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button x:Name="OkButton" Content="{loc:Loc common.validate}" Padding="16,6" Click="Ok_Click" IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
