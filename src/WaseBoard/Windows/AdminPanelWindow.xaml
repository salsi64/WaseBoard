<Window x:Class="WaseBoard.Windows.AdminPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:WaseBoard.Services.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:WaseBoard.Windows.Chrome"
        Title="{loc:Loc admin.title}"
        FontFamily="Segoe UI Emoji, Segoe UI" Height="600" Width="860"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        chrome:WindowChromeBehavior.Enable="True">
    <Border x:Name="RootChromeBorder" CornerRadius="8" Background="{DynamicResource SurfaceBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <chrome:TitleBarControl Grid.Row="0" TitleText="{loc:Loc admin.title}" ShowMinMax="True"/>

        <!-- Serveur géré + message d'état (chargement / erreur / confirmation) -->
        <DockPanel Grid.Row="1" Margin="16,8,16,4">
            <TextBlock Text="{loc:Loc admin.discord_server}" VerticalAlignment="Center" Margin="0,0,10,0"
                       Foreground="{DynamicResource TextBrush}" FontSize="12"/>
            <ComboBox x:Name="GuildCombo" Width="260" Height="34" SelectionChanged="GuildCombo_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2,2">
                            <Ellipse Width="20" Height="20" Margin="0,0,8,0">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding IconUrl, Converter={StaticResource UriToBitmapImageConverter}}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="{Binding GuildName}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock x:Name="StatusText" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="12"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}"/>
        </DockPanel>

        <Grid Grid.Row="2" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="12,8,4,8">
                <Button x:Name="NavSoundsButton" Content="{loc:Loc admin.nav.sounds}" Tag="Sounds" Click="NavButton_Click" Style="{StaticResource SettingsNavButtonStyle}"/>
                <Button x:Name="NavTrashButton" Content="{loc:Loc admin.trash}" Tag="Trash" Click="NavButton_Click" Style="{StaticResource SettingsNavButtonStyle}"/>
                <Button x:Name="NavSettingsButton" Content="{loc:Loc admin.nav.settings}" Tag="Settings" Click="NavButton_Click" Style="{StaticResource SettingsNavButtonStyle}"/>
                <Button x:Name="NavStatsButton" Content="{loc:Loc admin.nav.stats}" Tag="Stats" Click="NavButton_Click" Style="{StaticResource SettingsNavButtonStyle}"/>
                <Button x:Name="NavAuditButton" Content="{loc:Loc admin.nav.audit}" Tag="Audit" Click="NavButton_Click" Style="{StaticResource SettingsNavButtonStyle}"/>
                <Button x:Name="NavInviteButton" Content="{loc:Loc admin.nav.invite}" Tag="Invite" Click="NavButton_Click" Style="{StaticResource SettingsNavButtonStyle}"/>
            </StackPanel>

            <Border Grid.Column="1" Background="{DynamicResource CardBrush}" CornerRadius="8" Margin="4,8,12,12">
            <Grid Margin="18,16,18,16">

                <!-- Page : Sons de la guilde -->
                <Grid x:Name="PageSounds">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBox x:Name="SoundFilterBox" Width="190" Height="28" DockPanel.Dock="Right"
                                 ToolTip="{loc:Loc admin.filter_tooltip}" TextChanged="SoundFilterBox_TextChanged"/>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc admin.server_sounds}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="SoundsSummaryText" FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="104"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="104"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="{loc:Loc admin.col.name}" Opacity="0.6" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Grid.Column="2" Text="{loc:Loc admin.col.author}" Opacity="0.6" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Grid.Column="3" Text="{loc:Loc admin.col.added}" Opacity="0.6" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Grid.Column="4" Text="{loc:Loc admin.col.size}" Opacity="0.6" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Grid.Column="5" Text="{loc:Loc admin.col.plays}" Opacity="0.6" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SoundsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,2" Height="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="62"/>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="104"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Emoji}" FontSize="16" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Author}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding AuthorTooltip}" Foreground="{DynamicResource TextBrush}" Opacity="0.85"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Date}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" Opacity="0.85" FontSize="12"/>
                                        <TextBlock Grid.Column="4" Text="{Binding SizeText}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" Opacity="0.85" FontSize="12"/>
                                        <TextBlock Grid.Column="5" Text="{Binding PlaysText}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" Opacity="0.85" FontSize="12"/>
                                        <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="✏" Width="30" Height="28" Margin="0,0,3,0" Tag="{Binding}" Click="RenameSound_Click"
                                                    ToolTip="{loc:Loc admin.rename_tooltip}" Style="{StaticResource SecondaryButtonStyle}"/>
                                            <Button Content="🗑" Width="30" Height="28" Margin="0,0,3,0" Tag="{Binding}" Click="DeleteSound_Click"
                                                    ToolTip="{loc:Loc admin.delete_tooltip}" Style="{StaticResource SecondaryButtonStyle}"/>
                                            <Button Content="🚫" Width="30" Height="28" Tag="{Binding}" Click="BlockAuthor_Click"
                                                    IsEnabled="{Binding CanBlock}" ToolTip="{Binding BlockTooltip}"
                                                    Style="{StaticResource SecondaryButtonStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Page : Corbeille -->
                <Grid x:Name="PageTrash" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="{loc:Loc admin.trash}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock x:Name="TrashSummaryText" FontSize="11" Opacity="0.7" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TrashList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,2" Height="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="86"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Emoji}" FontSize="16" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DeletedByText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextBrush}" Opacity="0.85" FontSize="12"/>
                                        <TextBlock Grid.Column="3" Text="{Binding DeletedAtText}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}" Opacity="0.85" FontSize="12"/>
                                        <Button Grid.Column="4" Content="{loc:Loc admin.restore}" Height="28" Padding="8,0" Tag="{Binding}" Click="RestoreSound_Click"
                                                ToolTip="{Binding DaysLeftText}" Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                                BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Page : Réglages -->
                <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="{loc:Loc admin.settings.title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>

                        <TextBlock Text="{loc:Loc admin.settings.admin_role}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="{loc:Loc admin.settings.admin_role_hint}"
                                   FontSize="11" Opacity="0.7" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                        <!-- ItemTemplate (pas DisplayMemberPath) : le style de ComboBox de l'app n'applique pas
                             DisplayMemberPath à la valeur affichée une fois fermé. -->
                        <ComboBox x:Name="AdminRoleCombo" Height="34" Width="260" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <CheckBox x:Name="UploadAdminsOnlyCheck" Content="{loc:Loc admin.settings.upload_admins_only}"
                                  Foreground="{DynamicResource TextBrush}" Margin="0,0,0,16"/>

                        <TextBlock Text="{loc:Loc admin.settings.limits}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc admin.settings.max_sounds}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontSize="12"/>
                            <TextBox x:Name="MaxSoundsBox" Grid.Column="1" Height="28"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc admin.settings.max_file}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontSize="12"/>
                            <TextBox x:Name="MaxFileMbBox" Grid.Column="1" Height="28"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc admin.settings.max_duration}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontSize="12"/>
                            <TextBox x:Name="MaxDurationBox" Grid.Column="1" Height="28"/>
                        </Grid>
                        <Grid x:Name="MaxTotalRow" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc admin.settings.max_total}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontSize="12"/>
                            <TextBox x:Name="MaxTotalMbBox" Grid.Column="1" Height="28"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc admin.settings.antispam}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontSize="12"/>
                            <TextBox x:Name="PlayRateBox" Grid.Column="1" Height="28"/>
                        </Grid>
                        <TextBlock Text="{loc:Loc admin.settings.antispam_hint}"
                                   FontSize="11" Opacity="0.7" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="QuotaUsageText" FontSize="11" Opacity="0.85" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"
                                   Visibility="Collapsed"/>
                        <TextBlock x:Name="CeilingsText" FontSize="11" Opacity="0.85" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,16"
                                   Visibility="Collapsed"/>

                        <Button Content="{loc:Loc admin.settings.save}" Height="34" HorizontalAlignment="Left" Padding="16,0" Margin="0,0,0,22"
                                Click="SaveSettings_Click" Style="{StaticResource PrimaryButtonStyle}"/>

                        <TextBlock Text="{loc:Loc admin.blocked.title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="{loc:Loc admin.blocked.hint}"
                                   FontSize="11" Opacity="0.7" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="NoBlockedText" Text="{loc:Loc admin.blocked.none}" FontSize="12" Opacity="0.7" Foreground="{DynamicResource TextBrush}"/>
                        <ItemsControl x:Name="BlockedList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="{loc:Loc admin.blocked.unblock}" Height="28" Padding="10,0" Tag="{Binding}" Click="Unblock_Click"
                                                Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                                BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}"/>
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Page : Statistiques -->
                <ScrollViewer x:Name="PageStats" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <DockPanel Margin="0,0,0,12">
                            <ComboBox x:Name="StatsPeriodCombo" DockPanel.Dock="Right" Width="130" Height="30" SelectionChanged="StatsPeriodCombo_SelectionChanged">
                                <ComboBoxItem Content="{loc:Loc admin.stats.7d}" Tag="7"/>
                                <ComboBoxItem Content="{loc:Loc admin.stats.30d}" Tag="30" IsSelected="True"/>
                                <ComboBoxItem Content="{loc:Loc admin.stats.90d}" Tag="90"/>
                            </ComboBox>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc admin.stats.title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock x:Name="StatsTotalText" FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="{loc:Loc admin.stats.per_day}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                        <ItemsControl x:Name="DayBars" Height="110" Margin="0,0,0,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="{Binding BarHeight}" VerticalAlignment="Bottom" Margin="1,0" CornerRadius="2,2,0,0"
                                            Background="{DynamicResource AccentBrush}" ToolTip="{Binding Tooltip}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="0,0,0,18">
                            <TextBlock x:Name="DayAxisEndText" DockPanel.Dock="Right" FontSize="10" Opacity="0.6" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="DayAxisStartText" FontSize="10" Opacity="0.6" Foreground="{DynamicResource TextBrush}"/>
                        </DockPanel>

                        <TextBlock Text="{loc:Loc admin.stats.top_sounds}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="NoTopSoundsText" Text="{loc:Loc admin.stats.none}" FontSize="12" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,18"/>
                        <ItemsControl x:Name="TopSoundsList" Margin="0,0,0,18">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4" Height="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Emoji}" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   ToolTip="{Binding Name}" Foreground="{DynamicResource TextBrush}"/>
                                        <Border Grid.Column="2" Height="10" CornerRadius="5" HorizontalAlignment="Left" Width="{Binding BarWidth}"
                                                Background="{DynamicResource AccentBrush}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Count}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}" FontSize="12"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{loc:Loc admin.stats.top_members}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                        <ItemsControl x:Name="TopUsersList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4" Height="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Left" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding AvatarUrl, Converter={StaticResource UriToBitmapImageConverter}}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <Border Grid.Column="2" Height="10" CornerRadius="5" HorizontalAlignment="Left" Width="{Binding BarWidth}"
                                                Background="{DynamicResource AccentBrush}" Opacity="0.7"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Count}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}" FontSize="12"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Page : Journal d'actions -->
                <Grid x:Name="PageAudit" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="{loc:Loc admin.audit.title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock x:Name="AuditSummaryText" FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AuditList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding When}" FontSize="12" Opacity="0.65" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Page : Invitation -->
                <StackPanel x:Name="PageInvite" Visibility="Collapsed">
                    <TextBlock Text="{loc:Loc admin.invite.title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{loc:Loc admin.invite.hint}"
                               FontSize="11" Opacity="0.7" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14"/>
                    <Button x:Name="CopyInviteButton" Content="{loc:Loc invite.copy}" Height="34" HorizontalAlignment="Left" Padding="16,0" Margin="0,0,0,18"
                            Click="CopyInvite_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                    <TextBlock Text="{loc:Loc admin.invite.in_discord}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{loc:Loc admin.invite.in_discord_hint}"
                               FontSize="11" Opacity="0.7" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Grid>
            </Border>
        </Grid>
    </Grid>
    </Border>
</Window>
