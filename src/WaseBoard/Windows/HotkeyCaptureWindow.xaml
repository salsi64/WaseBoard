<Window x:Class="WaseBoard.Windows.HotkeyCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:WaseBoard.Services.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:WaseBoard.Windows.Chrome"
        Title="{loc:Loc hotkey.title}"
        FontFamily="Segoe UI Emoji, Segoe UI" Height="180" Width="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        chrome:WindowChromeBehavior.Enable="True"
        ResizeMode="NoResize"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border x:Name="RootChromeBorder" CornerRadius="8" Background="{DynamicResource SurfaceBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <chrome:TitleBarControl Grid.Row="0" TitleText="{loc:Loc hotkey.title}" ShowMinMax="False"/>
            <StackPanel Grid.Row="1" Margin="20,4,20,20" VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc hotkey.prompt}"
                           Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                    <TextBlock x:Name="CapturedText" Text="{loc:Loc hotkey.waiting}" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Loc common.cancel}" Padding="12,6" Margin="0,0,8,0" Click="Cancel_Click"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button x:Name="ConfirmButton" Content="{loc:Loc common.validate}" Padding="16,6" IsEnabled="False" Click="Confirm_Click"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
