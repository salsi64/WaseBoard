<Window x:Class="WaseBoard.Windows.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:WaseBoard.Windows.Chrome"
        Title="Bienvenue sur WaseBoard"
        FontFamily="Segoe UI Emoji, Segoe UI" Height="460" Width="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        chrome:WindowChromeBehavior.Enable="True"
        ResizeMode="NoResize">
    <Border x:Name="RootChromeBorder" CornerRadius="8" Background="{DynamicResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <chrome:TitleBarControl x:Name="TitleBar" Grid.Row="0" TitleText="Bienvenue sur WaseBoard" ShowMinMax="False"/>

            <Grid Grid.Row="1" Margin="24,8,24,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Bannière de contexte : pourquoi cet écran apparaît (reconnexion, serveur caduc...) —
                     masquée par défaut, affichée/renseignée en code-behind selon OnboardingReason. -->
                <Border x:Name="ContextBanner" Grid.Row="0" Visibility="Collapsed" Background="{DynamicResource PanelBrush}"
                        CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                    <TextBlock x:Name="ContextBannerText" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextBrush}"/>
                </Border>

                <Grid Grid.Row="1">
                    <!-- Étape 1 : bienvenue -->
                    <StackPanel x:Name="StepWelcome">
                        <TextBlock Text="🎛️" FontSize="40" HorizontalAlignment="Center" Margin="0,10,0,16"/>
                        <TextBlock Text="Bienvenue sur WaseBoard" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Opacity="0.85"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"
                                   Text="WaseBoard est un soundboard partagé pour Discord : cliquez un son, il joue à la fois sur vos enceintes et dans votre salon vocal, pour tout le monde."/>
                        <TextBlock x:Name="ServerModeExplainText" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Opacity="0.7"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock x:Name="UseCustomServerLink" FontSize="11" Opacity="0.75" TextAlignment="Center"
                                   Margin="0,12,0,0" Visibility="Collapsed">
                            <Hyperlink Click="UseCustomServer_Click" Foreground="{DynamicResource AccentBrush}">Vous avez votre propre serveur WaseBoard ?</Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <!-- Étape 2 : serveur -->
                    <StackPanel x:Name="StepServer" Visibility="Collapsed">
                        <TextBlock Text="Serveur WaseBoard" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,4"/>
                        <TextBlock FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" TextWrapping="Wrap"
                                   Text="Le catalogue de sons et le bot Discord qui les joue sont hébergés sur un serveur — pas fourni avec l'application, chaque groupe héberge le sien."/>
                        <TextBlock FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14" TextWrapping="Wrap">
                            <Run Text="Si on vous a invité : demandez l'adresse et le jeton à la personne qui héberge. Sinon : "/>
                            <Hyperlink NavigateUri="https://github.com/salsi64/WaseBoard/blob/master/server/README.md" RequestNavigate="Hyperlink_RequestNavigate"
                                       Foreground="{DynamicResource AccentBrush}">hébergez le vôtre</Hyperlink>
                            <Run Text=" (gratuit, ~15 minutes)."/>
                        </TextBlock>

                        <TextBlock Text="Adresse du serveur" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="ServerUrlBox" Height="28" Margin="0,0,0,10"
                                 ToolTip="Ex: https://mon-serveur.exemple — demandez-la à qui héberge votre serveur WaseBoard"/>

                        <TextBlock Text="Jeton d'accès" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="ServerTokenBox" Height="28" Margin="0,0,0,10"/>

                        <Button x:Name="TestConnectionButton" Content="Tester la connexion" Height="34"
                                Click="TestConnectionButton_Click"
                                Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                BorderThickness="1" BorderBrush="{DynamicResource TextBrush}"/>
                        <TextBlock x:Name="ServerResultText" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>

                    <!-- Étape 3 : connexion Discord -->
                    <StackPanel x:Name="StepDiscord" Visibility="Collapsed">
                        <TextBlock Text="Connexion Discord" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,4"/>
                        <TextBlock Text="Permet d'afficher votre avatar quand vous jouez un son, et de retrouver automatiquement le bon salon vocal." FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <TextBlock FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14" TextWrapping="Wrap"
                                   Text="Un bot Discord (ajouté au serveur du Discord concerné par la personne qui héberge) rejoint votre salon vocal et joue les sons — jamais via votre micro. Une fois connecté, faites « /join » dans Discord (ou le bouton « 🔊 Rejoindre mon vocal » dans WaseBoard) pour que le bot vous rejoigne."/>

                        <Button x:Name="ConnectDiscordButton" Content="Se connecter avec Discord" Height="34" Click="ConnectDiscordButton_Click"
                                Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}" BorderThickness="0"/>

                        <Border x:Name="DiscordResultBorder" CornerRadius="6" Padding="8" Visibility="Collapsed" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,8,0" x:Name="DiscordAvatarBorder" Visibility="Collapsed">
                                    <Border.Background>
                                        <ImageBrush x:Name="DiscordAvatarBrush" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                <TextBlock x:Name="DiscordResultText" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Margin="24,16,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StepIndicatorText" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Opacity="0.5"
                           Foreground="{DynamicResource TextBrush}" Text="Étape 1 sur 3"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BackButton" Content="Précédent" Padding="14,6" Margin="0,0,8,0" Click="Back_Click"
                            Background="Transparent" Foreground="{DynamicResource TextBrush}" Visibility="Collapsed"/>
                    <Button x:Name="SkipButton" Content="Passer" Padding="14,6" Margin="0,0,8,0" Click="Skip_Click"
                            Background="Transparent" Foreground="{DynamicResource TextBrush}"/>
                    <Button x:Name="NextButton" Content="Suivant" Padding="18,6" Click="Next_Click" IsDefault="True"
                            Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
