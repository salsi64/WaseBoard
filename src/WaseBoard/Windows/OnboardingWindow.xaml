<Window x:Class="WaseBoard.Windows.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:WaseBoard.Services.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:WaseBoard.Windows.Chrome"
        Title="{loc:Loc onboarding.welcome_title}"
        FontFamily="Segoe UI Emoji, Segoe UI" Height="460" Width="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        chrome:WindowChromeBehavior.Enable="True"
        ResizeMode="NoResize">
    <Border x:Name="RootChromeBorder" CornerRadius="8" Background="{DynamicResource SurfaceBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <chrome:TitleBarControl x:Name="TitleBar" Grid.Row="0" TitleText="{loc:Loc onboarding.welcome_title}" ShowMinMax="False"/>

            <Grid Grid.Row="1" Margin="24,8,24,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Bannière de contexte : pourquoi cet écran apparaît (reconnexion, serveur caduc...) —
                     masquée par défaut, affichée/renseignée en code-behind selon OnboardingReason. -->
                <Border x:Name="ContextBanner" Grid.Row="0" Visibility="Collapsed" Background="{DynamicResource CardBrush}"
                        CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                    <TextBlock x:Name="ContextBannerText" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextBrush}"/>
                </Border>

                <Grid Grid.Row="1">
                    <!-- Étape 1 : bienvenue -->
                    <StackPanel x:Name="StepWelcome">
                        <TextBlock Text="🎛️" FontSize="40" HorizontalAlignment="Center" Margin="0,10,0,16"/>
                        <TextBlock Text="{loc:Loc onboarding.welcome_title}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Opacity="0.85"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"
                                   Text="{loc:Loc onboarding.welcome_text}"/>
                        <TextBlock x:Name="ServerModeExplainText" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Opacity="0.7"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock x:Name="UseCustomServerLink" FontSize="11" Opacity="0.75" TextAlignment="Center"
                                   Margin="0,12,0,0" Visibility="Collapsed">
                            <Hyperlink Click="UseCustomServer_Click" Foreground="{DynamicResource AccentBrush}">Vous avez votre propre serveur WaseBoard ?</Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <!-- Étape 2 : serveur -->
                    <StackPanel x:Name="StepServer" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc server.title}" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,4"/>
                        <TextBlock FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" TextWrapping="Wrap"
                                   Text="{loc:Loc onboarding.server_intro}"/>
                        <TextBlock FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14" TextWrapping="Wrap">
                            <Run Text="{loc:Loc onboarding.server_invited}"/>
                            <Hyperlink NavigateUri="https://github.com/salsi64/WaseBoard/blob/master/server/README.md" RequestNavigate="Hyperlink_RequestNavigate"
                                       Foreground="{DynamicResource AccentBrush}"><Run Text="{loc:Loc onboarding.host_your_own}"/></Hyperlink>
                            <Run Text="{loc:Loc onboarding.server_free}"/>
                        </TextBlock>

                        <TextBlock Text="{loc:Loc server.address}" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="ServerUrlBox" Height="28" Margin="0,0,0,10"
                                 ToolTip="{loc:Loc onboarding.address_tooltip}"/>

                        <TextBlock Text="{loc:Loc server.token}" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="ServerTokenBox" Height="28" Margin="0,0,0,10"/>

                        <Button x:Name="TestConnectionButton" Content="{loc:Loc server.test}" Height="34"
                                Click="TestConnectionButton_Click"
                                Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}"/>
                        <TextBlock x:Name="ServerResultText" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>

                    <!-- Étape 3 : connexion Discord -->
                    <StackPanel x:Name="StepDiscord" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc discord.title}" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,4"/>
                        <TextBlock Text="{loc:Loc onboarding.discord_intro}" FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <TextBlock FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14" TextWrapping="Wrap"
                                   Text="{loc:Loc onboarding.discord_bot}"/>

                        <Button x:Name="ConnectDiscordButton" Content="{loc:Loc onboarding.sign_in}" Height="34" Click="ConnectDiscordButton_Click"
                                Style="{StaticResource PrimaryButtonStyle}"/>

                        <Border x:Name="DiscordResultBorder" CornerRadius="6" Padding="8" Visibility="Collapsed" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,8,0" x:Name="DiscordAvatarBorder" Visibility="Collapsed">
                                    <Border.Background>
                                        <ImageBrush x:Name="DiscordAvatarBrush" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                <TextBlock x:Name="DiscordResultText" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Margin="24,16,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StepIndicatorText" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Opacity="0.5"
                           Foreground="{DynamicResource TextBrush}" Text="{loc:Loc onboarding.step_default}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BackButton" Content="{loc:Loc onboarding.back}" Padding="14,6" Margin="0,0,8,0" Click="Back_Click"
                            Background="Transparent" Foreground="{DynamicResource TextBrush}" Visibility="Collapsed"/>
                    <Button x:Name="SkipButton" Content="{loc:Loc onboarding.skip}" Padding="14,6" Margin="0,0,8,0" Click="Skip_Click"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button x:Name="NextButton" Content="{loc:Loc onboarding.next}" Padding="18,6" Click="Next_Click" IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
