<Window x:Class="WaseBoard.Windows.GuildPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:WaseBoard.Services.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:WaseBoard.Windows.Chrome"
        Title="{loc:Loc guild_picker.title}"
        Height="220" Width="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        chrome:WindowChromeBehavior.Enable="True"
        ResizeMode="NoResize">
    <Border x:Name="RootChromeBorder" CornerRadius="8" Background="{DynamicResource SurfaceBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <chrome:TitleBarControl Grid.Row="0" TitleText="{loc:Loc guild_picker.title}" ShowMinMax="False"/>
            <StackPanel Grid.Row="1" Margin="16,4,16,16">
                <TextBlock Text="{loc:Loc guild_picker.prompt}" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                <ComboBox x:Name="GuildCombo" Height="36" Margin="0,0,0,16"
                          SelectionChanged="GuildCombo_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2,2">
                                <Ellipse Width="20" Height="20" Margin="0,0,8,0">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding IconUrl, Converter={StaticResource UriToBitmapImageConverter}}" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Text="{Binding GuildName}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="{loc:Loc common.cancel}" Padding="10,6" Margin="0,0,8,0" Click="Cancel_Click"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button x:Name="OkButton" Content="{loc:Loc common.validate}" Padding="16,6" Click="Ok_Click" IsDefault="True"
                            IsEnabled="False"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
