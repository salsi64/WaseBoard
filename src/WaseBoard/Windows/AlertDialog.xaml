<Window x:Class="WaseBoard.Windows.AlertDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:WaseBoard.Windows.Chrome"
        Title="WaseBoard"
        FontFamily="Segoe UI Emoji, Segoe UI" Height="170" Width="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        chrome:WindowChromeBehavior.Enable="True"
        ResizeMode="NoResize">
    <Border x:Name="RootChromeBorder" CornerRadius="8" Background="{DynamicResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <chrome:TitleBarControl x:Name="TitleBar" Grid.Row="0" TitleText="WaseBoard" ShowMinMax="False"/>
            <StackPanel Grid.Row="1" Margin="20,4,20,20">
                <StackPanel Orientation="Horizontal" Margin="0,4,0,20">
                    <TextBlock x:Name="IconText" Text="ℹ" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Top"/>
                    <TextBlock x:Name="MessageText" Foreground="{DynamicResource TextBrush}"
                               TextWrapping="Wrap" FontSize="13" MaxWidth="290" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="OK" Padding="20,6" HorizontalAlignment="Right" Click="Ok_Click"
                        IsDefault="True" IsCancel="True"
                        Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
