<Window x:Class="WaseBoard.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:WaseBoard.Windows.Chrome"
        xmlns:loc="clr-namespace:WaseBoard.Services.Localization"
        Title="{loc:Loc common.settings}"
        FontFamily="Segoe UI Emoji, Segoe UI" Height="480" Width="620"
        MinHeight="380" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        chrome:WindowChromeBehavior.Enable="True">
    <Border x:Name="RootChromeBorder" CornerRadius="8" Background="{DynamicResource SurfaceBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <chrome:TitleBarControl Grid.Row="0" TitleText="{loc:Loc common.settings}" ShowMinMax="True"/>

        <Grid Grid.Row="1" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation : une entrée par section, plus minimaliste que l'ancien empilement
                 vertical de cartes (moins de défilement, structure plus claire). -->
            <StackPanel Grid.Column="0" Margin="12,8,4,8">
                <Button x:Name="NavServerButton" Content="{loc:Loc settings.nav.server}" Tag="Server" Click="NavButton_Click" Style="{StaticResource SettingsNavButtonStyle}"/>
                <Button x:Name="NavDiscordButton" Content="Discord" Tag="Discord" Click="NavButton_Click" Style="{StaticResource SettingsNavButtonStyle}"/>
                <Button x:Name="NavAppearanceButton" Content="{loc:Loc settings.appearance.title}" Tag="Appearance" Click="NavButton_Click" Style="{StaticResource SettingsNavButtonStyle}"/>
                <Button x:Name="NavVolumeButton" Content="{loc:Loc settings.nav.volume}" Tag="Volume" Click="NavButton_Click" Style="{StaticResource SettingsNavButtonStyle}"/>
                <Button x:Name="NavMicButton" Content="{loc:Loc settings.nav.mic}" Tag="Mic" Click="NavButton_Click" Style="{StaticResource SettingsNavButtonStyle}"/>
                <Button x:Name="NavClipButton" Content="{loc:Loc settings.nav.clip}" Tag="Clip" Click="NavButton_Click" Style="{StaticResource SettingsNavButtonStyle}"/>
                <Button x:Name="NavUpdatesButton" Content="{loc:Loc settings.updates.title}" Tag="Updates" Click="NavButton_Click" Style="{StaticResource SettingsNavButtonStyle}"/>
                <Button x:Name="NavDiagnosticButton" Content="{loc:Loc settings.nav.diagnostic}" Tag="Diagnostic" Click="NavButton_Click" Style="{StaticResource SettingsNavButtonStyle}"/>
                <!-- Visible seulement si l'on administre au moins un serveur Discord -->
                <Button x:Name="NavAdminButton" Content="{loc:Loc settings.nav.admin}" Tag="Admin" Click="NavButton_Click" Visibility="Collapsed"
                        Style="{StaticResource SettingsNavButtonStyle}"/>
            </StackPanel>

            <Border Grid.Column="1" Background="{DynamicResource CardBrush}" CornerRadius="8" Margin="4,8,12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <Grid Margin="20">

                    <!-- Page : Serveur -->
                    <StackPanel x:Name="PageServer">
                        <TextBlock Text="{loc:Loc server.title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{loc:Loc settings.server.intro}" FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                        <TextBlock Text="{loc:Loc server.address}" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="ServerUrlBox" Height="28" Margin="0,0,0,10"
                                 ToolTip="{loc:Loc settings.server.address_tooltip}"/>

                        <TextBlock Text="{loc:Loc server.token}" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="ServerTokenBox" Height="28" Margin="0,0,0,14"/>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TestConnectionButton" Content="{loc:Loc server.test}" Height="34" HorizontalAlignment="Left" Padding="16,0" Margin="0,0,8,0"
                                    Click="TestConnectionButton_Click"
                                    Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                    BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}"/>
                            <Button x:Name="CopyInviteLinkButton" Content="{loc:Loc invite.copy}" Height="34" HorizontalAlignment="Left" Padding="16,0"
                                    Click="CopyInviteLinkButton_Click"
                                    ToolTip="{loc:Loc settings.server.copy_invite_tooltip}"
                                    Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                    BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Page : Discord -->
                    <StackPanel x:Name="PageDiscord" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc discord.title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{loc:Loc settings.discord.intro}" FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ConnectDiscordButton" Content="{loc:Loc settings.discord.connect}" Height="34" Click="ConnectDiscordButton_Click"
                                    HorizontalAlignment="Left" Padding="14,0"
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                            <Button x:Name="LogoutDiscordButton" Content="{loc:Loc settings.discord.logout}" Height="34" Padding="14,0" Margin="8,0,0,0"
                                    Click="LogoutDiscordButton_Click" Visibility="Collapsed"
                                    Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                    BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}"/>
                        </StackPanel>

                        <Border x:Name="VerifyResultBorder" CornerRadius="6" Padding="8" Visibility="Collapsed" Margin="0,10,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="24" Height="24" CornerRadius="12" Margin="0,0,8,0" x:Name="VerifyAvatarBorder" Visibility="Collapsed">
                                    <Border.Background>
                                        <ImageBrush x:Name="VerifyAvatarBrush" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                <TextBlock x:Name="VerifyResultText" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Page : Apparence -->
                    <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc settings.appearance.title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>

                        <TextBlock Text="{loc:Loc settings.appearance.language}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                        <ComboBox x:Name="LanguageCombo" Width="200" Height="30" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                        <TextBlock Text="{loc:Loc settings.appearance.language_hint}" FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                        <TextBlock Text="{loc:Loc settings.appearance.palette}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                        <WrapPanel x:Name="PaletteList" Margin="0,0,0,16"/>

                        <CheckBox x:Name="FollowSystemThemeCheckBox" Content="{loc:Loc settings.appearance.follow_theme}"
                                  Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"
                                  Checked="FollowSystemTheme_Changed" Unchecked="FollowSystemTheme_Changed"/>
                        <CheckBox x:Name="FollowSystemAccentCheckBox" Content="{loc:Loc settings.appearance.follow_accent}"
                                  Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"
                                  Checked="FollowSystemTheme_Changed" Unchecked="FollowSystemTheme_Changed"/>
                        <TextBlock Text="{loc:Loc settings.appearance.light_note}" FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                        <TextBlock Text="{loc:Loc settings.appearance.style}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button x:Name="ClassicThemeButton" Content="{loc:Loc settings.appearance.style_classic}" Padding="14,6" Margin="0,0,8,0" Click="ClassicThemeButton_Click"
                                    Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}"/>
                            <Button x:Name="ModernThemeButton" Content="{loc:Loc settings.appearance.style_modern}" Padding="14,6" Margin="0,0,8,0" Click="ModernThemeButton_Click"
                                    Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}"/>
                            <Button x:Name="FlatThemeButton" Content="Flat" Padding="14,6" Click="FlatThemeButton_Click"
                                    Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}"/>
                        </StackPanel>

                        <TextBlock Text="{loc:Loc settings.appearance.buttons}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                        <CheckBox x:Name="ShowWaveformsCheckBox" Content="{loc:Loc settings.appearance.waveform}"
                                  Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{loc:Loc settings.appearance.waveform_hint}" FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                        <StackPanel x:Name="ManualColorSection">
                            <TextBlock Text="{loc:Loc settings.appearance.custom_bg}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc settings.appearance.custom_bg_hint}" FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CustomColorBox" Grid.Column="0" Height="28" Margin="0,0,8,0" ToolTip="{loc:Loc settings.appearance.hex_tooltip}"/>
                                <Button Grid.Column="1" Content="{loc:Loc common.apply}" Padding="10,0" Margin="0,0,6,0" Click="ApplyCustomColor_Click"
                                        Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                        BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}"/>
                                <Button Grid.Column="2" Content="{loc:Loc common.clear}" Padding="10,0" Click="ClearCustomColor_Click"
                                        Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                        BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}"/>
                            </Grid>

                            <Border x:Name="ColorPreview" Height="30" CornerRadius="6" BorderBrush="{DynamicResource TextBrush}" BorderThickness="1"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Page : Volume -->
                    <StackPanel x:Name="PageVolume" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc settings.volume.title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{loc:Loc settings.volume.hint}" FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="LocalVolumeSlider" Minimum="0" Maximum="1.5" Value="1.0"
                                    ValueChanged="LocalVolumeSlider_ValueChanged"/>
                            <TextBlock x:Name="LocalVolumeLabel" Grid.Column="1" Text="100%" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Opacity="0.8"/>
                        </Grid>
                    </StackPanel>

                    <!-- Page : Micro en jeu (fonction expérimentale) : 1. installer l'effet sur le micro,
                         2. régler. Textes volontairement courts. -->
                    <StackPanel x:Name="PageMic" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{loc:Loc settings.mic.title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            <Border Margin="10,0,0,0" Padding="7,1" CornerRadius="8" VerticalAlignment="Center"
                                    Background="#26F5A623" BorderBrush="#F5A623" BorderThickness="1">
                                <TextBlock Text="{loc:Loc settings.mic.experimental}" FontSize="10" FontWeight="Bold" Foreground="#F5A623"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{loc:Loc settings.mic.intro}" FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2" TextWrapping="Wrap"/>
                        <TextBlock Text="{loc:Loc settings.mic.beta_note}" FontSize="11" Foreground="#F5A623" Margin="0,0,0,16" TextWrapping="Wrap"/>

                        <!-- 1. Installation -->
                        <TextBlock Text="{loc:Loc settings.mic.step1}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="MicFxStatusText" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <StackPanel x:Name="MicFxMicList" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,2">
                            <Button x:Name="MicFxInstallButton" Content="{loc:Loc settings.mic.install}" Height="34" Padding="16,0" Margin="0,0,8,6"
                                    Click="MicFxInstallButton_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                            <Button x:Name="MicFxTestButton" Content="{loc:Loc settings.mic.test}" Height="34" Padding="16,0" Margin="0,0,8,6"
                                    Click="MicFxTestButton_Click" ToolTip="{loc:Loc settings.mic.test_tooltip}"
                                    Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                    BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}"/>
                            <Button x:Name="MicFxUninstallButton" Content="{loc:Loc settings.mic.uninstall}" Height="34" Padding="16,0" Margin="0,0,0,6"
                                    Click="MicFxUninstallButton_Click"
                                    Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                    BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}"/>
                        </WrapPanel>
                        <TextBlock Text="{loc:Loc settings.mic.admin_note}" FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                        <TextBlock x:Name="MicFxLiveText" FontSize="11" Opacity="0.8" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,18" TextWrapping="Wrap"/>

                        <!-- 2. Réglages -->
                        <TextBlock Text="{loc:Loc settings.mic.step2}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                        <CheckBox x:Name="MicFeatureEnabledCheckBox" Content="{loc:Loc settings.mic.enable}"
                                  Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <TextBlock Text="{loc:Loc settings.mic.enable_hint}" FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="20,0,0,10" TextWrapping="Wrap"/>

                        <TextBlock Text="{loc:Loc settings.mic.volume}" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="MicFeedVolumeSlider" Minimum="0" Maximum="1.5" Value="0.8"
                                    ValueChanged="MicFeedVolumeSlider_ValueChanged"/>
                            <TextBlock x:Name="MicFeedVolumeLabel" Grid.Column="1" Text="80%" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Opacity="0.8"/>
                        </Grid>

                        <CheckBox x:Name="MicFeedMonitorCheckBox" Content="{loc:Loc settings.mic.hear_myself}"
                                  Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="{loc:Loc settings.mic.hear_myself_hint}" FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="20,0,0,8" TextWrapping="Wrap"/>
                        <CheckBox x:Name="MicFeedAlsoDiscordCheckBox" Content="{loc:Loc settings.mic.also_discord}"
                                  Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="{loc:Loc settings.mic.also_discord_hint}" FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="20,0,0,0" TextWrapping="Wrap"/>

                        <TextBlock Text="{loc:Loc settings.mic.hotkey_title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,18,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border CornerRadius="6" Padding="12,6" MinWidth="150" Margin="0,0,8,0" Background="{DynamicResource FieldBrush}">
                                <TextBlock x:Name="MicModeHotkeyText" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            </Border>
                            <Button x:Name="MicModeHotkeySetButton" Content="{loc:Loc settings.mic.hotkey_set}" Height="30" Padding="14,0" Margin="0,0,6,0"
                                    Click="MicModeHotkeySetButton_Click"
                                    Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                    BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}"/>
                            <Button x:Name="MicModeHotkeyClearButton" Content="{loc:Loc settings.mic.hotkey_clear}" Height="30" Padding="14,0"
                                    Click="MicModeHotkeyClearButton_Click"
                                    Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                    BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{loc:Loc settings.mic.hotkey_hint}" FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <CheckBox x:Name="MicModeBeepCheckBox" Content="{loc:Loc settings.mic.hotkey_beep}"
                                  Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                    </StackPanel>

                    <!-- Page : Clip des dernières secondes -->
                    <StackPanel x:Name="PageClip" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc settings.clip.title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{loc:Loc settings.clip.intro}" FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                        <CheckBox x:Name="ClipEnabledCheckBox" Content="{loc:Loc settings.clip.enable}"
                                  Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <TextBlock Text="{loc:Loc settings.clip.enable_hint}" FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="20,0,0,14" TextWrapping="Wrap"/>

                        <TextBlock Text="{loc:Loc settings.clip.seconds}" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ClipSecondsCombo" Width="160" Height="30" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                        <TextBlock Text="{loc:Loc settings.clip.hotkey_title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border CornerRadius="6" Padding="12,6" MinWidth="150" Margin="0,0,8,0" Background="{DynamicResource FieldBrush}">
                                <TextBlock x:Name="ClipHotkeyText" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            </Border>
                            <Button x:Name="ClipHotkeySetButton" Content="{loc:Loc settings.mic.hotkey_set}" Height="30" Padding="14,0" Margin="0,0,6,0"
                                    Click="ClipHotkeySetButton_Click"
                                    Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                    BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}"/>
                            <Button x:Name="ClipHotkeyClearButton" Content="{loc:Loc settings.mic.hotkey_clear}" Height="30" Padding="14,0"
                                    Click="ClipHotkeyClearButton_Click"
                                    Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                    BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{loc:Loc settings.clip.hotkey_hint}" FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <CheckBox x:Name="ClipBeepCheckBox" Content="{loc:Loc settings.clip.beep}"
                                  Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                    </StackPanel>

                    <!-- Page : Mises à jour -->
                    <StackPanel x:Name="PageUpdates" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc settings.updates.title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="CurrentVersionText" FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                        <Button x:Name="CheckUpdateButton" Content="{loc:Loc settings.updates.check}" Height="34" HorizontalAlignment="Left" Padding="16,0"
                                Click="CheckUpdateButton_Click"
                                Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}"/>
                        <TextBlock x:Name="UpdateResultText" Margin="0,10,0,10" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                        <Button x:Name="OpenReleaseButton" Content="{loc:Loc settings.updates.view}" Height="34" HorizontalAlignment="Left" Padding="16,0"
                                Click="OpenReleaseButton_Click" Visibility="Collapsed"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>

                    <!-- Page : Diagnostic (latence, versions, rapport à copier pour une demande d'aide) -->
                    <StackPanel x:Name="PageDiagnostic" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc settings.diagnostic.title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{loc:Loc settings.diagnostic.intro}" FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button x:Name="RunDiagnosticButton" Content="{loc:Loc settings.diagnostic.run}" Height="34" Padding="16,0" Margin="0,0,8,0"
                                    Click="RunDiagnosticButton_Click"
                                    Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                    BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}"/>
                            <Button x:Name="CopyDiagnosticButton" Content="{loc:Loc settings.diagnostic.copy}" Height="34" Padding="16,0" IsEnabled="False"
                                    Click="CopyDiagnosticButton_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>

                        <Border CornerRadius="6" Padding="12,10" Background="{DynamicResource FieldBrush}">
                            <TextBlock x:Name="DiagnosticText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- Page : Administration (admins de serveur uniquement) -->
                    <StackPanel x:Name="PageAdmin" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc settings.admin.title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="AdminSummaryText" FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                        <Button x:Name="OpenAdminPanelButton" Content="{loc:Loc settings.admin.open}" Height="34" HorizontalAlignment="Left" Padding="16,0"
                                Click="OpenAdminPanelButton_Click"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                        <TextBlock Text="{loc:Loc settings.admin.hint}"
                                   FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Button Grid.Row="1" Content="{loc:Loc common.save}" Height="38" HorizontalAlignment="Right" Width="130" Margin="20,0,20,16"
                    Style="{StaticResource PrimaryButtonStyle}"
                    FontWeight="SemiBold" Click="SaveButton_Click"/>
            </Grid>
            </Border>
        </Grid>
    </Grid>
    </Border>
</Window>
