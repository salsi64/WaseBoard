<Window x:Class="WaseBoard.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:WaseBoard.Windows.Chrome"
        Title="Paramètres"
        FontFamily="Segoe UI Emoji, Segoe UI" Height="480" Width="620"
        MinHeight="380" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        chrome:WindowChromeBehavior.Enable="True">
    <Border x:Name="RootChromeBorder" CornerRadius="8" Background="{DynamicResource SurfaceBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <chrome:TitleBarControl Grid.Row="0" TitleText="Paramètres" ShowMinMax="True"/>

        <Grid Grid.Row="1" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation : une entrée par section, plus minimaliste que l'ancien empilement
                 vertical de cartes (moins de défilement, structure plus claire). -->
            <StackPanel Grid.Column="0" Margin="12,8,4,8">
                <Button x:Name="NavServerButton" Content="Serveur" Tag="Server" Click="NavButton_Click" Style="{StaticResource SettingsNavButtonStyle}"/>
                <Button x:Name="NavDiscordButton" Content="Discord" Tag="Discord" Click="NavButton_Click" Style="{StaticResource SettingsNavButtonStyle}"/>
                <Button x:Name="NavAppearanceButton" Content="Apparence" Tag="Appearance" Click="NavButton_Click" Style="{StaticResource SettingsNavButtonStyle}"/>
                <Button x:Name="NavVolumeButton" Content="Volume" Tag="Volume" Click="NavButton_Click" Style="{StaticResource SettingsNavButtonStyle}"/>
                <Button x:Name="NavMicButton" Content="🎮 Micro en jeu" Tag="Mic" Click="NavButton_Click" Style="{StaticResource SettingsNavButtonStyle}"/>
                <Button x:Name="NavUpdatesButton" Content="Mises à jour" Tag="Updates" Click="NavButton_Click" Style="{StaticResource SettingsNavButtonStyle}"/>
                <!-- Visible seulement si l'on administre au moins un serveur Discord -->
                <Button x:Name="NavAdminButton" Content="🛡 Administration" Tag="Admin" Click="NavButton_Click" Visibility="Collapsed"
                        Style="{StaticResource SettingsNavButtonStyle}"/>
            </StackPanel>

            <Border Grid.Column="1" Background="{DynamicResource CardBrush}" CornerRadius="8" Margin="4,8,12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <Grid Margin="20">

                    <!-- Page : Serveur -->
                    <StackPanel x:Name="PageServer">
                        <TextBlock Text="Serveur WaseBoard" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Le catalogue de sons et le bot Discord sont hébergés sur ce serveur, partagé entre tous les utilisateurs." FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                        <TextBlock Text="Adresse du serveur" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="ServerUrlBox" Height="28" Margin="0,0,0,10"
                                 ToolTip="Ex: https://mon-serveur.exemple — voir server/README.md pour héberger le vôtre"/>

                        <TextBlock Text="Jeton d'accès" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="ServerTokenBox" Height="28" Margin="0,0,0,14"/>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TestConnectionButton" Content="Tester la connexion" Height="34" HorizontalAlignment="Left" Padding="16,0" Margin="0,0,8,0"
                                    Click="TestConnectionButton_Click"
                                    Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                    BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}"/>
                            <Button x:Name="CopyInviteLinkButton" Content="Copier le lien d'invitation" Height="34" HorizontalAlignment="Left" Padding="16,0"
                                    Click="CopyInviteLinkButton_Click"
                                    ToolTip="Génère un lien waseboard:// à partir de l'adresse/jeton ci-dessus, pour inviter quelqu'un sans qu'il ait à les saisir"
                                    Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                    BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Page : Discord -->
                    <StackPanel x:Name="PageDiscord" Visibility="Collapsed">
                        <TextBlock Text="Connexion Discord" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Permet d'afficher votre avatar quand vous jouez un son, et de retrouver automatiquement le bon salon vocal. Obligatoire." FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                        <Button x:Name="ConnectDiscordButton" Content="Se connecter avec Discord" Height="34" Click="ConnectDiscordButton_Click"
                                HorizontalAlignment="Left" Padding="14,0"
                                Style="{StaticResource PrimaryButtonStyle}"/>

                        <Border x:Name="VerifyResultBorder" CornerRadius="6" Padding="8" Visibility="Collapsed" Margin="0,10,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="24" Height="24" CornerRadius="12" Margin="0,0,8,0" x:Name="VerifyAvatarBorder" Visibility="Collapsed">
                                    <Border.Background>
                                        <ImageBrush x:Name="VerifyAvatarBrush" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                <TextBlock x:Name="VerifyResultText" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Page : Apparence -->
                    <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                        <TextBlock Text="Apparence" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>

                        <TextBlock Text="Palette" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                        <WrapPanel x:Name="PaletteList" Margin="0,0,0,16"/>

                        <CheckBox x:Name="FollowSystemThemeCheckBox" Content="Suivre le thème clair/sombre de Windows"
                                  Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"
                                  Checked="FollowSystemTheme_Changed" Unchecked="FollowSystemTheme_Changed"/>
                        <CheckBox x:Name="FollowSystemAccentCheckBox" Content="Suivre la couleur d'accent de Windows (remplace l'accent de la palette)"
                                  Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"
                                  Checked="FollowSystemTheme_Changed" Unchecked="FollowSystemTheme_Changed"/>
                        <TextBlock Text="Avec le thème Windows clair, la palette claire s'applique ; le choix ci-dessus ne change alors que l'accent." FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                        <TextBlock Text="Thème de l'interface" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button x:Name="ClassicThemeButton" Content="Classique" Padding="14,6" Margin="0,0,8,0" Click="ClassicThemeButton_Click"
                                    Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}"/>
                            <Button x:Name="ModernThemeButton" Content="Moderne" Padding="14,6" Margin="0,0,8,0" Click="ModernThemeButton_Click"
                                    Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}"/>
                            <Button x:Name="FlatThemeButton" Content="Flat" Padding="14,6" Click="FlatThemeButton_Click"
                                    Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}"/>
                        </StackPanel>

                        <TextBlock Text="Boutons de son" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                        <CheckBox x:Name="ShowWaveformsCheckBox" Content="Afficher la forme d'onde (waveform) sur les boutons"
                                  Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Décochée, les boutons tiennent sur une seule ligne (plus de sons visibles à la fois). L'avatar de la personne qui joue reste affiché, à droite du nom." FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                        <StackPanel x:Name="ManualColorSection">
                            <TextBlock Text="Fond personnalisé (avancé)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Remplace le fond de la palette quand « suivre le thème Windows » est désactivé. Laissez vide pour garder celui de la palette." FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CustomColorBox" Grid.Column="0" Height="28" Margin="0,0,8,0" ToolTip="Code hexadécimal, ex : #101820"/>
                                <Button Grid.Column="1" Content="Appliquer" Padding="10,0" Margin="0,0,6,0" Click="ApplyCustomColor_Click"
                                        Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                        BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}"/>
                                <Button Grid.Column="2" Content="Effacer" Padding="10,0" Click="ClearCustomColor_Click"
                                        Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                        BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}"/>
                            </Grid>

                            <Border x:Name="ColorPreview" Height="30" CornerRadius="6" BorderBrush="{DynamicResource TextBrush}" BorderThickness="1"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Page : Volume -->
                    <StackPanel x:Name="PageVolume" Visibility="Collapsed">
                        <TextBlock Text="Volume d'aperçu" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Volume de la lecture locale déclenchée par l'icône mégaphone (aperçu, jamais envoyé à Discord)." FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="LocalVolumeSlider" Minimum="0" Maximum="1.5" Value="1.0"
                                    ValueChanged="LocalVolumeSlider_ValueChanged"/>
                            <TextBlock x:Name="LocalVolumeLabel" Grid.Column="1" Text="100%" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Opacity="0.8"/>
                        </Grid>
                    </StackPanel>

                    <!-- Page : Micro en jeu (fonction expérimentale) : 1. installer l'effet sur le micro,
                         2. régler. Textes volontairement courts. -->
                    <StackPanel x:Name="PageMic" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Micro en jeu" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            <Border Margin="10,0,0,0" Padding="7,1" CornerRadius="8" VerticalAlignment="Center"
                                    Background="#26F5A623" BorderBrush="#F5A623" BorderThickness="1">
                                <TextBlock Text="EXPÉRIMENTAL" FontSize="10" FontWeight="Bold" Foreground="#F5A623"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Vos sons passent dans votre micro : vos coéquipiers les entendent dans le vocal du jeu." FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2" TextWrapping="Wrap"/>
                        <TextBlock Text="Fonction en test : elle peut ne pas marcher avec tous les micros." FontSize="11" Foreground="#F5A623" Margin="0,0,0,16" TextWrapping="Wrap"/>

                        <!-- 1. Installation -->
                        <TextBlock Text="1. Installer sur votre micro" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="MicFxStatusText" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <StackPanel x:Name="MicFxMicList" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,2">
                            <Button x:Name="MicFxInstallButton" Content="Installer" Height="34" Padding="16,0" Margin="0,0,8,6"
                                    Click="MicFxInstallButton_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                            <Button x:Name="MicFxTestButton" Content="Tester" Height="34" Padding="16,0" Margin="0,0,8,6"
                                    Click="MicFxTestButton_Click" ToolTip="Envoie un bip dans votre micro"
                                    Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                    BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}"/>
                            <Button x:Name="MicFxUninstallButton" Content="Désinstaller" Height="34" Padding="16,0" Margin="0,0,0,6"
                                    Click="MicFxUninstallButton_Click"
                                    Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                    BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}"/>
                        </WrapPanel>
                        <TextBlock Text="Demande les droits administrateur. Le son se coupe 2 secondes." FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                        <TextBlock x:Name="MicFxLiveText" FontSize="11" Opacity="0.8" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,18" TextWrapping="Wrap"/>

                        <!-- 2. Réglages -->
                        <TextBlock Text="2. Réglages" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                        <CheckBox x:Name="MicFeatureEnabledCheckBox" Content="Activer le micro en jeu"
                                  Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,2"/>
                        <TextBlock Text="Affiche le bouton 🎮 Jeu / 🎧 Discord sur la page principale." FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="20,0,0,10" TextWrapping="Wrap"/>

                        <TextBlock Text="Volume des sons dans le micro" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="MicFeedVolumeSlider" Minimum="0" Maximum="1.5" Value="0.8"
                                    ValueChanged="MicFeedVolumeSlider_ValueChanged"/>
                            <TextBlock x:Name="MicFeedVolumeLabel" Grid.Column="1" Text="80%" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Opacity="0.8"/>
                        </Grid>

                        <CheckBox x:Name="MicFeedMonitorCheckBox" Content="M'entendre aussi"
                                  Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="Décochez si vos coéquipiers n'entendent pas les sons." FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="20,0,0,8" TextWrapping="Wrap"/>
                        <CheckBox x:Name="MicFeedAlsoDiscordCheckBox" Content="Jouer aussi dans Discord (bot)"
                                  Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="Laissez décoché si Discord utilise ce micro (sinon, son en double)." FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="20,0,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Page : Mises à jour -->
                    <StackPanel x:Name="PageUpdates" Visibility="Collapsed">
                        <TextBlock Text="Mises à jour" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="CurrentVersionText" FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                        <Button x:Name="CheckUpdateButton" Content="Rechercher les mises à jour" Height="34" HorizontalAlignment="Left" Padding="16,0"
                                Click="CheckUpdateButton_Click"
                                Background="Transparent" Foreground="{DynamicResource TextBrush}"
                                BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}"/>
                        <TextBlock x:Name="UpdateResultText" Margin="0,10,0,10" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                        <Button x:Name="OpenReleaseButton" Content="Voir la nouvelle version" Height="34" HorizontalAlignment="Left" Padding="16,0"
                                Click="OpenReleaseButton_Click" Visibility="Collapsed"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>

                    <!-- Page : Administration (admins de serveur uniquement) -->
                    <StackPanel x:Name="PageAdmin" Visibility="Collapsed">
                        <TextBlock Text="Administration" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="AdminSummaryText" FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                        <Button x:Name="OpenAdminPanelButton" Content="Ouvrir le panel d'administration" Height="34" HorizontalAlignment="Left" Padding="16,0"
                                Click="OpenAdminPanelButton_Click"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                        <TextBlock Text="Sons du serveur, corbeille, réglages (rôle admin, quotas, anti-spam, membres bloqués), statistiques, journal d'actions et lien d'invitation."
                                   FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Button Grid.Row="1" Content="Enregistrer" Height="38" HorizontalAlignment="Right" Width="130" Margin="20,0,20,16"
                    Style="{StaticResource PrimaryButtonStyle}"
                    FontWeight="SemiBold" Click="SaveButton_Click"/>
            </Grid>
            </Border>
        </Grid>
    </Grid>
    </Border>
</Window>
