<Window x:Class="WaseBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WaseBoard"
        xmlns:chrome="clr-namespace:WaseBoard.Windows.Chrome"
        Title="WaseBoard"
        FontFamily="Segoe UI Emoji, Segoe UI" Height="680" Width="960"
        Icon="Assets/app.ico"
        Background="{DynamicResource BgBrush}"
        chrome:WindowChromeBehavior.Enable="True"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="MainWindow_PreviewKeyDown"
        AllowDrop="True" DragEnter="Window_DragEnter" DragLeave="Window_DragLeave" Drop="Window_Drop"
        PreviewDragOver="Window_PreviewDragOver"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <local:SoundButtonTemplateSelector x:Key="SoundButtonTemplateSelector"/>

        <!-- Gabarit classique (carte) réutilisé pour chaque bouton de son. -->
        <DataTemplate x:Key="SoundButtonTemplate">
            <Button Width="136" Height="68" Margin="5"
                    Click="SoundButton_Click"
                    MouseRightButtonUp="SoundButton_RightClick"
                    PreviewMouseLeftButtonDown="SoundButton_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="SoundButton_PreviewMouseMove"
                    DragOver="SoundButton_DragOver" DragLeave="SoundButton_DragLeave"
                    Tag="{Binding}"
                    Background="{DynamicResource PanelBrush}"
                    Foreground="{DynamicResource TextBrush}"
                    BorderThickness="2"
                    BorderBrush="Transparent"
                    FontSize="12"
                    FontWeight="SemiBold"
                    ToolTip="Clic gauche : jouer dans le vocal • Clic droit : options • Glisser : déplacer/classer • 📣 : aperçu local">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#7C5CFF" BlurRadius="22" ShadowDepth="0" Opacity="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            MouseLeftButtonDown="PreviewIcon_MouseLeftButtonDown" Cursor="Hand"
                            ToolTip="Aperçu (lecture locale uniquement, sans envoi à Discord)">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#77000000"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPreviewing}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="📣" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="14"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,8,0">
                                <Image Source="{Binding Emoji, Converter={StaticResource EmojiToImageSourceConverter}}"
                                       Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="90" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="★" FontSize="12" Foreground="Gold" FontWeight="Bold"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                                       Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <!-- Badge de raccourci clavier, visible seulement au survol du bouton -->
                            <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,2,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Hotkey, Converter={StaticResource StringNotEmptyConverter}}" Value="True"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Hotkey}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            </Border>

                            <ItemsControl ItemsSource="{Binding ActiveUsers}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,1">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="14" Height="14" CornerRadius="7" Margin="0,0,2,0"
                                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                                ToolTip="{Binding Username}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding AvatarUrl, Converter={StaticResource UriToBitmapImageConverter}}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- Mini-waveform (thème classique uniquement) : calculée en arrière-plan, voir SoundItem.WaveformPeaks -->
                        <Path Grid.Row="1" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Opacity="0.55"
                              Stretch="Fill" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="2,0"
                              Data="{Binding WaveformPeaks, Converter={StaticResource WaveformPeaksToPathConverter}, ConverterParameter='96,12'}"/>
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Gabarit moderne (pilule) réutilisé pour chaque bouton de son, façon maquette. -->
        <DataTemplate x:Key="ModernSoundButtonTemplate">
            <Button Height="42" Margin="4" ClipToBounds="True"
                    Click="SoundButton_Click"
                    MouseRightButtonUp="SoundButton_RightClick"
                    PreviewMouseLeftButtonDown="SoundButton_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="SoundButton_PreviewMouseMove"
                    DragOver="SoundButton_DragOver" DragLeave="SoundButton_DragLeave"
                    Tag="{Binding}"
                    Foreground="{DynamicResource TextBrush}"
                    FontSize="12" FontWeight="SemiBold"
                    ToolTip="Clic gauche : jouer dans le vocal • Clic droit : options • Glisser : déplacer/classer">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder" Background="{DynamicResource PanelBrush}" CornerRadius="21"
                                BorderThickness="2" BorderBrush="Transparent" Padding="4,0,14,0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="PillBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#7C5CFF" BlurRadius="18" ShadowDepth="0" Opacity="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="15" Margin="0,0,10,0"
                            MouseLeftButtonDown="PreviewIcon_MouseLeftButtonDown" Cursor="Hand"
                            ToolTip="Aperçu (lecture locale uniquement, sans envoi à Discord)">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{Binding Id, Converter={StaticResource IdToColorConverter}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPreviewing}" Value="True">
                                        <Setter Property="Background" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Image Source="{Binding Emoji, Converter={StaticResource EmojiToImageSourceConverter}, ConverterParameter=🔊}"
                               Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="★" Foreground="Gold" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- Badge de raccourci clavier, visible seulement au survol du bouton -->
                    <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Hotkey, Converter={StaticResource StringNotEmptyConverter}}" Value="True"/>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Hotkey}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    </Border>

                    <!-- Avatars de qui joue ce son en ce moment (déjà présent en thème Classique). -->
                    <ItemsControl ItemsSource="{Binding ActiveUsers}" Margin="8,0,0,0" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="16" Height="16" CornerRadius="8" Margin="0,0,3,0"
                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                        ToolTip="{Binding Username}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding AvatarUrl, Converter={StaticResource UriToBitmapImageConverter}}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- Gabarit d'une section (★ Favoris, une catégorie personnelle, ou une guilde Discord) : un accordéon repliable. -->
        <DataTemplate x:Key="SectionTemplate">
            <Expander IsExpanded="{Binding IsExpanded, Mode=OneTime}" Tag="{Binding CategoryKey}"
                      Expanded="Section_Expanded" Collapsed="Section_Collapsed" Loaded="Section_Loaded" Margin="0,0,0,10"
                      Foreground="{DynamicResource TextBrush}" Background="Transparent"
                      PreviewMouseLeftButtonDown="SectionHeader_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="SectionHeader_PreviewMouseMove">
                <Expander.Header>
                    <Border Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="10,6" HorizontalAlignment="Left"
                            BorderThickness="0" BorderBrush="Transparent" Tag="{Binding}"
                            AllowDrop="True" Drop="SectionHeader_Drop"
                            DragEnter="SectionHeader_DragEnter" DragLeave="SectionHeader_DragLeave"
                            MouseRightButtonUp="SectionHeader_RightClick">
                    <DockPanel MinWidth="160">
                        <Border Width="18" Height="18" CornerRadius="9" DockPanel.Dock="Left" Margin="4,0,4,0"
                                Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding IconUrl, Converter={StaticResource UriToBitmapImageConverter}}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>

                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center" DockPanel.Dock="Left" Margin="4,0,0,0"/>

                        <ItemsControl ItemsSource="{Binding OnlineUsers}" DockPanel.Dock="Left" Margin="10,0,0,0"
                                      Visibility="{Binding IsShared, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="18" Height="18" CornerRadius="9" Margin="0,0,3,0"
                                            BorderBrush="#4CAF50" BorderThickness="2" ToolTip="{Binding Username}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding AvatarUrl, Converter={StaticResource UriToBitmapImageConverter}}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- Tri, sections de guilde uniquement : seules vouées à devenir vraiment
                                 longues (catalogue d'un serveur entier), les autres restent des sélections
                                 courtes et manuelles où un tri n'apporterait rien. -->
                            <ComboBox Width="132" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"
                                      SelectionChanged="AllSoundsSort_SelectionChanged" Loaded="AllSoundsSortCombo_Loaded"
                                      Visibility="{Binding IsAllSounds, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ComboBoxItem Content="Ordre personnalisé" Tag="Custom"/>
                                <ComboBoxItem Content="Nom (A → Z)" Tag="NameAsc"/>
                                <ComboBoxItem Content="Nom (Z → A)" Tag="NameDesc"/>
                            </ComboBox>
                            <!-- Marqueur purement visuel (pas de handler propre) : la barre entière reste
                                 déplaçable via SectionHeader_PreviewMouseMove, ce repère indique juste que
                                 c'est possible, à la place des anciennes flèches ↑/↓. -->
                            <TextBlock Text="⠿" FontSize="14" Opacity="0.35" Margin="0,0,8,0" VerticalAlignment="Center"
                                       Cursor="SizeAll" ToolTip="Glisser pour réordonner"
                                       Foreground="{DynamicResource TextBrush}"
                                       Visibility="{Binding IsReorderable, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsManageable, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button Content="✎" Width="22" Height="20" Margin="2,0" FontSize="10"
                                        Click="RenameCategory_Click" Tag="{Binding}"
                                        Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0"/>
                                <Button Content="🗑" Width="22" Height="20" Margin="2,0" FontSize="10"
                                        Click="DeleteCategory_Click" Tag="{Binding}"
                                        Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                    </Border>
                </Expander.Header>

                <Border Background="{DynamicResource BgBrush}" CornerRadius="6" Padding="8" MinHeight="40"
                        AllowDrop="True" Drop="Section_Drop" Tag="{Binding}">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Sounds}" ItemTemplateSelector="{StaticResource SoundButtonTemplateSelector}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><local:AnimatedWrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Text="Glissez un son ici pour l'ajouter" FontSize="11" Opacity="0.5"
                                   Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Border>
            </Expander>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootChromeBorder" CornerRadius="8" Background="{DynamicResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <chrome:TitleBarControl x:Name="ChromeTitleBar" Grid.Row="0" TitleText="WaseBoard" ShowMinMax="True"/>

        <!-- "Now playing" : qui joue quoi en ce moment, dérivé du même sondage d'activité que le
             highlight des boutons (aucun appel réseau supplémentaire). Barre fixe (hauteur stable),
             affiche un texte de repli quand rien ne joue plutôt que de disparaître. -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" Padding="14,6" Height="40" ClipToBounds="True">
            <Grid>
                <ItemsControl ItemsSource="{Binding NowPlayingEntries, RelativeSource={RelativeSource AncestorType=Window}}"
                              Visibility="{Binding NowPlayingEntries.Count, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CountToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Background="{DynamicResource BgBrush}" Padding="8,4" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="18" Height="18" CornerRadius="9" Margin="0,0,6,0"
                                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding AvatarUrl, Converter={StaticResource UriToBitmapImageConverter}}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center">
                                        <Run Text="{Binding Username, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text=" joue "/>
                                        <InlineUIContainer BaselineAlignment="Center">
                                            <Image Source="{Binding Emoji, Mode=OneWay, Converter={StaticResource EmojiToImageSourceConverter}}"
                                                   Width="13" Height="13"/>
                                        </InlineUIContainer>
                                        <Run Text=" "/>
                                        <Run Text="{Binding SoundName, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Rien ne joue actuellement" FontSize="11" Opacity="0.5"
                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                           Visibility="{Binding NowPlayingEntries.Count, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}"/>

                <!-- Statut serveur ("Connecté — X son(s)") : déplacé ici depuis la barre d'outils
                     pour lui laisser de la place, aligné à droite de cette même barre. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="2,0,6,0" VerticalAlignment="Center">
                        <Ellipse.RenderTransform>
                            <ScaleTransform CenterX="4" CenterY="4"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Resources>
                            <Storyboard x:Key="StatusDotPulse" RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.6">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </Ellipse.Resources>
                    </Ellipse>
                    <TextBlock x:Name="ServerStatusText" Text="" FontSize="12" Opacity="0.7"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

    <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="0"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Barre latérale (thème moderne uniquement) -->
        <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource PanelBrush}" Visibility="Collapsed">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,4,0,16">
                    <Button x:Name="SidebarToggleButton" DockPanel.Dock="Right" Content="◀" Width="32" Height="32" FontSize="14" FontWeight="Bold"
                            Click="SidebarToggle_Click" ToolTip="Réduire/agrandir la barre latérale" Cursor="Hand"
                            Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0"/>
                    <StackPanel x:Name="SidebarHeaderText">
                        <TextBlock x:Name="SidebarHeaderTitle" Text="🎛️ WaseBoard" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Ta base de sons, toujours avec toi." FontSize="10" Opacity="0.6" Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>

                <!-- Membres actuellement en vocal avec vous : toujours visible, même barre réduite.
                     L'avatar de celui/celle qui joue un son s'illumine en même temps que le bouton. -->
                <StackPanel Grid.Row="1" Margin="0,0,0,14">
                    <TextBlock x:Name="VoiceMembersLabel" Text="🔊 En vocal avec vous" FontSize="10" Opacity="0.5"
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding VoiceChannelMembers, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="30" Height="30" CornerRadius="15" Margin="0,0,6,6"
                                        BorderThickness="2" ToolTip="{Binding Username}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#7C5CFF" BlurRadius="12" ShadowDepth="0" Opacity="0.95"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding AvatarUrl, Converter={StaticResource UriToBitmapImageConverter}}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Button x:Name="SidebarHomeButton" Grid.Row="2" Content="🏠 Accueil" Click="NavHome_Click"
                        HorizontalContentAlignment="Left" Height="36" Margin="0,0,0,8" Padding="10,0"
                        Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"/>

                <!-- Liste dynamique : une entrée par section actuellement affichée (Favoris, chaque
                     catégorie perso, chaque guilde Discord), pas seulement des raccourcis fixes. -->
                <ScrollViewer x:Name="SidebarNavScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="SidebarNavItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding}" Click="NavItem_Click"
                                        AllowDrop="True" Drop="NavItem_Drop"
                                        PreviewMouseLeftButtonDown="NavItem_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="NavItem_PreviewMouseMove"
                                        HorizontalContentAlignment="Left" Height="32" Margin="0,0,0,4" Padding="8,0"
                                        FontSize="12" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="18" Height="18" CornerRadius="9" Margin="0,0,8,0"
                                                Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding IconUrl, Converter={StaticResource UriToBitmapImageConverter}}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="SidebarFooter" Grid.Row="4" Margin="0,12,0,0">
                    <!-- Équivalent du slider de la barre d'outils classique (MainVolumePanel), qui
                         reste masqué en thème moderne pour ne pas le dupliquer — voir ApplyTheme(). -->
                    <StackPanel Orientation="Horizontal" Margin="2,0,2,10">
                        <TextBlock Text="🔊" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextBrush}"/>
                        <Slider x:Name="SidebarVolumeSlider" Width="110" Minimum="0" Maximum="1.5" Value="1.0"
                                ValueChanged="VolumeSlider_ValueChanged" ToolTip="Volume d'écoute local (aperçu uniquement, jamais envoyé à Discord)"/>
                        <TextBlock x:Name="SidebarVolumeLabel" Text="100%" FontSize="11" Opacity="0.7" Width="34"
                                   VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                    <Button Content="⚙ Paramètres" Click="SettingsButton_Click" HorizontalContentAlignment="Left" Height="34" Margin="0,0,0,8" Padding="10,0"
                            Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0"/>
                    <Border Background="{DynamicResource BgBrush}" CornerRadius="8" Padding="10">
                        <StackPanel>
                            <TextBlock x:Name="SidebarConnectionText" Text="🔴 Non connecté" FontSize="12" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="WaseBoard v2.4" FontSize="10" Opacity="0.5" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenu principal -->
        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barre unique : titre, statut serveur, recherche, actions. Le bouton Paramètres et
                 le slider de volume (MainVolumePanel) ont chacun un équivalent dans la barre
                 latérale du thème moderne ; ils ne restent visibles ICI qu'en thème classique
                 (pas de barre latérale), pour ne pas dupliquer les contrôles — voir ApplyTheme(). -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock x:Name="TitleText" Text="🎛️ WaseBoard" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" DockPanel.Dock="Left"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="RefreshButton" Content="⟳ Actualiser" Padding="10,6" Margin="0,0,6,0"
                            Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="1"
                            BorderBrush="{DynamicResource TextBrush}" Click="RefreshButton_Click"/>
                    <Button x:Name="JoinVoiceButton" Content="🔊 Rejoindre mon vocal" Padding="10,6" Margin="0,0,6,0"
                            Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="1"
                            BorderBrush="{DynamicResource TextBrush}" Click="JoinVoiceButton_Click"
                            ToolTip="Fait rejoindre le bot au salon vocal où vous êtes actuellement"/>
                    <Button x:Name="StopAllButton" Content="⏹ Stop tout" Padding="10,6" Margin="0,0,6,0"
                            Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="1"
                            BorderBrush="{DynamicResource TextBrush}" Click="StopAllButton_Click"/>
                    <Button x:Name="SettingsButton" Content="⚙ Paramètres" Padding="10,6" Margin="0,0,6,0"
                            Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="1"
                            BorderBrush="{DynamicResource TextBrush}" Click="SettingsButton_Click"/>
                    <Button x:Name="AddCategoryButton" Content="+ Nouvelle catégorie ▾" Padding="10,6" Margin="0,0,6,0"
                            Click="AddCategoryButton_Click"
                            Background="Transparent" Foreground="{DynamicResource TextBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource TextBrush}"/>
                    <Button x:Name="AddSoundButton" Content="+ Ajouter un son" Padding="10,6"
                            Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"
                            Click="AddSoundButton_Click"/>
                </StackPanel>

                <StackPanel x:Name="MainVolumePanel" Orientation="Horizontal" DockPanel.Dock="Right"
                            Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="🔊" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextBrush}"/>
                    <Slider x:Name="MainVolumeSlider" Width="80" Minimum="0" Maximum="1.5" Value="1.0"
                            ValueChanged="VolumeSlider_ValueChanged" ToolTip="Volume d'écoute local (aperçu uniquement, jamais envoyé à Discord)"/>
                    <TextBlock x:Name="MainVolumeLabel" Text="100%" FontSize="11" Opacity="0.7" Width="34"
                               VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>

                <Grid Margin="12,0" HorizontalAlignment="Stretch" MaxWidth="420">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextBrush}"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Height="28" HorizontalAlignment="Stretch"
                             TextChanged="SearchBox_TextChanged"
                             ToolTip="Rechercher un son par son nom"/>
                </Grid>
            </DockPanel>

            <!-- Sections : ★ Favoris, catégories personnalisées, puis une par guilde Discord -->
            <ScrollViewer x:Name="SectionsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="SectionsItemsControl" ItemTemplate="{StaticResource SectionTemplate}"/>
            </ScrollViewer>

            <!-- Overlay affiché pendant le survol d'un glisser-déposer de fichiers -->
            <Border x:Name="DropOverlay" Grid.Row="0" Grid.RowSpan="2"
                    Background="#CC1E1E2E" CornerRadius="8"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock Text="⬇ Déposez vos fichiers audio ici" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Copie flottante d'un bouton de son pendant son glisser-déposer (voir ShowDragVisual/
                 Window_PreviewDragOver) : suit le curseur pour bien montrer que le son "voyage" vers
                 l'endroit du dépôt, plutôt que de laisser le bouton d'origine seul immobile. -->
            <Canvas x:Name="DragVisualCanvas" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False"/>
        </Grid>
    </Grid>

    <!-- Overlay de notifications (toasts), remplace les MessageBox.Show ponctuels -->
    <ItemsControl Grid.Row="2" ItemsSource="{Binding Toasts, RelativeSource={RelativeSource AncestorType=Window}}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="12,10"
                        Margin="0,6,0,0" MaxWidth="320" BorderThickness="0,0,0,3" BorderBrush="{Binding AccentColor}"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Opacity="0.35"/>
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TranslateTransform X="40"/>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                     To="0" Duration="0:0:0.25">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Icon}" Foreground="{Binding AccentColor}" FontSize="15"
                                   Margin="0,0,8,0" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextBrush}" FontSize="12"
                                   TextWrapping="Wrap" MaxWidth="250"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Palette de commande (Ctrl+K) : recherche + lancement d'un son sans scroller -->
    <Grid x:Name="CommandPaletteOverlay" Grid.Row="0" Grid.RowSpan="3" Background="#AA000000"
          Visibility="Collapsed" MouseLeftButtonDown="CommandPaletteOverlay_MouseLeftButtonDown">
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Width="440" MaxHeight="420"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,90,0,0" Padding="6"
                MouseLeftButtonDown="CommandPalettePanel_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="4" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel>
                <TextBox x:Name="CommandPaletteBox" Margin="6" FontSize="16" Height="34" Padding="8,4"
                         TextChanged="CommandPaletteBox_TextChanged" PreviewKeyDown="CommandPaletteBox_PreviewKeyDown"/>
                <ListBox x:Name="CommandPaletteList" MaxHeight="320" BorderThickness="0" Background="Transparent"
                         MouseDoubleClick="CommandPaletteList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="6,5">
                                <Image Source="{Binding Emoji, Converter={StaticResource EmojiToImageSourceConverter}}"
                                       Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="13"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
    </Border>
</Window>
