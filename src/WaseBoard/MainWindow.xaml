<Window x:Class="WaseBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WaseBoard"
        xmlns:chrome="clr-namespace:WaseBoard.Windows.Chrome"
        Title="WaseBoard"
        FontFamily="Segoe UI Emoji, Segoe UI" Height="680" Width="960" MinHeight="480" MinWidth="760"
        Icon="Assets/app.ico"
        Background="{DynamicResource BgBrush}"
        chrome:WindowChromeBehavior.Enable="True"
        Loaded="Window_Loaded" Closing="Window_Closing" SizeChanged="Window_SizeChanged" PreviewKeyDown="MainWindow_PreviewKeyDown"
        AllowDrop="True" DragEnter="Window_DragEnter" DragLeave="Window_DragLeave" Drop="Window_Drop"
        PreviewDragOver="Window_PreviewDragOver"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <local:SoundButtonTemplateSelector x:Key="SoundButtonTemplateSelector"/>

        <!-- Halo de lecture : « respiration » lente d'un halo flou de la couleur du son, derrière le bouton
             (jamais d'Effect lié à une couleur : seul un Brush peut être lié, d'où un Border flouté plutôt
             qu'un DropShadowEffect). Visible uniquement pendant la lecture, donc aucun coût au repos. -->
        <Storyboard x:Key="HaloPulseStoryboard">
            <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity"
                             From="0.30" To="0.85" Duration="0:0:0.75" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Gabarit classique (carte) : colonne d'aperçu à gauche ; nom (2 lignes max), puis UNE ligne
             « ★ raccourci avatars » (hauteur réservée, rien ne se superpose), puis la mini-waveform. -->
        <DataTemplate x:Key="SoundButtonTemplate">
            <Button Width="136" Height="68" Margin="5"
                    Click="SoundButton_Click"
                    MouseRightButtonUp="SoundButton_RightClick"
                    PreviewMouseLeftButtonDown="SoundButton_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="SoundButton_PreviewMouseMove"
                    DragOver="SoundButton_DragOver" DragLeave="SoundButton_DragLeave"
                    Tag="{Binding}"
                    Foreground="{DynamicResource TextBrush}"
                    FontSize="12"
                    FontWeight="SemiBold"
                    ToolTip="{Binding ButtonTooltip}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Halo" Visibility="Collapsed" Margin="-6" CornerRadius="16" IsHitTestVisible="False" Opacity="0.3"
                                    Background="{Binding Id, Converter={StaticResource IdToColorConverter}}">
                                <Border.Effect><BlurEffect Radius="16"/></Border.Effect>
                            </Border>
                            <Border x:Name="CardBorder" Background="{DynamicResource PanelBrush}" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="4,3,4,2"/>
                            </Border>
                            <Border x:Name="Ring" Visibility="Collapsed" CornerRadius="10" BorderThickness="2" IsHitTestVisible="False"
                                    BorderBrush="{Binding Id, Converter={StaticResource IdToColorConverter}}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter TargetName="Halo" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="HaloPulse" Storyboard="{StaticResource HaloPulseStoryboard}"/>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="HaloPulse"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6"
                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
                            MouseLeftButtonDown="PreviewIcon_MouseLeftButtonDown" Cursor="Hand"
                            ToolTip="Aperçu (lecture locale uniquement, sans envoi à Discord)">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#77000000"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPreviewing}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="📣" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="12"/>
                        </Grid.RowDefinitions>

                        <!-- Emoji + nom (2 lignes max, tronqué) -->
                        <DockPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,2,0">
                            <Image DockPanel.Dock="Left" Source="{Binding Emoji, Converter={StaticResource EmojiToImageSourceConverter}}"
                                   Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32"
                                       TextAlignment="Left" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Une seule ligne d'indicateurs : ★ favori, raccourci (toujours affiché s'il existe), avatars -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="★" FontSize="11" Foreground="Gold" FontWeight="Bold" Margin="0,0,5,0" VerticalAlignment="Center"
                                       Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="4,0" Margin="0,0,5,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Hotkey, Converter={StaticResource StringNotEmptyConverter}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Hotkey}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding HasActivePlayers, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTip="{Binding ActiveUsersTooltip}">
                                <Border Width="14" Height="14" CornerRadius="7"
                                        BorderBrush="{DynamicResource TextBrush}" BorderThickness="1.5">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding PrimaryAvatarUrl, Converter={StaticResource UriToBitmapImageConverter}}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                <TextBlock Text="{Binding ExtraActiveUsersText}" FontSize="10" FontWeight="Bold" Margin="3,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"
                                           Visibility="{Binding HasExtraActivePlayers, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Mini-waveform : calculée en arrière-plan, voir SoundItem.WaveformPeaks -->
                        <!-- Son découpé : la portion gardée est en clair, le reste du son complet estompé (TrimMaskConverter). -->
                        <Path Grid.Row="2" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Opacity="0.85"
                              Stretch="Fill" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,0,2,0"
                              Data="{Binding WaveformPeaks, Converter={StaticResource WaveformPeaksToPathConverter}, ConverterParameter='96,10'}">
                            <Path.OpacityMask>
                                <MultiBinding Converter="{StaticResource TrimMaskConverter}">
                                    <Binding Path="TrimStartMs"/>
                                    <Binding Path="TrimEndMs"/>
                                    <Binding Path="DurationMs"/>
                                </MultiBinding>
                            </Path.OpacityMask>
                        </Path>
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Gabarit moderne (pilule à deux lignes) : largeur adaptée au nom (96 → 210 px, nom tronqué au-delà).
             Ligne du haut : pastille d'icône (couleur du son + emoji) et nom. Ligne du bas : mini-waveform du son
             (portion gardée en clair si le son est découpé) et, à droite, les avatars de ceux qui jouent ce son —
             nettement séparés de l'emoji. La hauteur de la ligne du bas est réservée en permanence, et la waveform
             s'adapte à la place restante : la pilule ne change jamais de taille pendant la lecture. Un halo de la
             couleur du son respire derrière. -->
        <DataTemplate x:Key="ModernSoundButtonTemplate">
            <Button Height="54" Margin="3" MinWidth="118" MaxWidth="210"
                    Click="SoundButton_Click"
                    MouseRightButtonUp="SoundButton_RightClick"
                    PreviewMouseLeftButtonDown="SoundButton_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="SoundButton_PreviewMouseMove"
                    DragOver="SoundButton_DragOver" DragLeave="SoundButton_DragLeave"
                    Tag="{Binding}"
                    Foreground="{DynamicResource TextBrush}"
                    FontSize="12" FontWeight="SemiBold"
                    ToolTip="{Binding ButtonTooltip}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Halo" Visibility="Collapsed" Margin="-5" CornerRadius="22" IsHitTestVisible="False" Opacity="0.3"
                                    Background="{Binding Id, Converter={StaticResource IdToColorConverter}}">
                                <Border.Effect><BlurEffect Radius="14"/></Border.Effect>
                            </Border>
                            <Border x:Name="PillBorder" Background="{DynamicResource PanelBrush}" CornerRadius="18"
                                    BorderThickness="2" BorderBrush="Transparent" Padding="4,3,15,4">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Ring" Visibility="Collapsed" CornerRadius="18" BorderThickness="2" IsHitTestVisible="False"
                                    BorderBrush="{Binding Id, Converter={StaticResource IdToColorConverter}}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter TargetName="Halo" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="HaloPulse" Storyboard="{StaticResource HaloPulseStoryboard}"/>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="HaloPulse"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="17"/>
                    </Grid.RowDefinitions>

                    <!-- Ligne du haut : pastille d'icône, nom, ★, raccourci (c'est elle qui fixe la largeur de la pilule) -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" Margin="0,0,8,0" Cursor="Hand"
                                MouseLeftButtonDown="PreviewIcon_MouseLeftButtonDown"
                                ToolTip="Aperçu (lecture locale uniquement, sans envoi à Discord)">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{Binding Id, Converter={StaticResource IdToColorConverter}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPreviewing}" Value="True">
                                            <Setter Property="Background" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Image Source="{Binding Emoji, Converter={StaticResource EmojiToImageSourceConverter}, ConverterParameter=🔊}"
                                   Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Column="2" Text="★" Foreground="Gold" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <!-- Badge de raccourci clavier : affiché en permanence s'il existe (jamais seulement au survol,
                             sinon la pilule s'élargirait au survol et décalerait ses voisines). -->
                        <Border Grid.Column="3" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Hotkey, Converter={StaticResource StringNotEmptyConverter}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Hotkey}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                        </Border>
                    </Grid>

                    <!-- Ligne du bas : mini-waveform (largeur naturelle faible : c'est le nom qui fixe la largeur de la pilule)
                         et avatars de ceux qui jouent ce son. Son découpé : portion gardée en clair, reste estompé. -->
                    <Grid Grid.Row="1" Margin="2,1,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <local:FillWidthHost Grid.Column="0" Height="8" Margin="0,0,2,0" VerticalAlignment="Center">
                            <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Opacity="0.85"
                                  Stretch="Fill"
                                  Data="{Binding WaveformPeaks, Converter={StaticResource WaveformPeaksToPathConverter}, ConverterParameter='40,8'}">
                                <Path.OpacityMask>
                                    <MultiBinding Converter="{StaticResource TrimMaskConverter}">
                                        <Binding Path="TrimStartMs"/>
                                        <Binding Path="TrimEndMs"/>
                                        <Binding Path="DurationMs"/>
                                    </MultiBinding>
                                </Path.OpacityMask>
                            </Path>
                        </local:FillWidthHost>
                        <!-- Un seul avatar (le premier) et « +N » si d'autres jouent le même son ; marge droite réservée
                             par le remplissage de la pilule pour que l'avatar ne soit jamais rogné par le coin arrondi. -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasActivePlayers, Converter={StaticResource BoolToVisibilityConverter}}"
                                    ToolTip="{Binding ActiveUsersTooltip}">
                            <Border Width="16" Height="16" CornerRadius="8"
                                    BorderBrush="{DynamicResource TextBrush}" BorderThickness="1.5">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding PrimaryAvatarUrl, Converter={StaticResource UriToBitmapImageConverter}}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <TextBlock Text="{Binding ExtraActiveUsersText}" FontSize="10" FontWeight="Bold" Margin="3,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"
                                       Visibility="{Binding HasExtraActivePlayers, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- En-tête d'un groupe repliable de la barre latérale (« Catégories », « Serveurs ») : flèche ▾/▸ + libellé. -->
        <Style x:Key="SidebarGroupHeaderStyle" TargetType="ToggleButton">
            <Setter Property="IsChecked" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="4,4">
                            <DockPanel>
                                <TextBlock x:Name="Arrow" DockPanel.Dock="Left" Text="▾" FontSize="10" Opacity="0.7" Width="14"
                                           VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Arrow" Property="Text" Value="▸"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Entrée de navigation (une catégorie ou un serveur) : compacte, alignée à gauche. -->
        <DataTemplate x:Key="SidebarNavItemTemplate">
            <Button Tag="{Binding}" Click="NavItem_Click"
                    AllowDrop="True" Drop="NavItem_Drop"
                    PreviewMouseLeftButtonDown="NavItem_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="NavItem_PreviewMouseMove"
                    HorizontalContentAlignment="Left" Height="28" Margin="14,0,0,2" Padding="8,0"
                    FontSize="12" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="16" Height="16" CornerRadius="8" Margin="0,0,7,0"
                            Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding IconUrl, Converter={StaticResource UriToBitmapImageConverter}}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- Gabarit d'une section (★ Favoris, une catégorie personnelle, ou une guilde Discord) : un accordéon repliable. -->
        <DataTemplate x:Key="SectionTemplate">
            <Expander IsExpanded="{Binding IsExpanded, Mode=OneTime}" Tag="{Binding CategoryKey}"
                      Expanded="Section_Expanded" Collapsed="Section_Collapsed" Loaded="Section_Loaded" Margin="0,0,0,6"
                      Foreground="{DynamicResource TextBrush}" Background="Transparent"
                      PreviewMouseLeftButtonDown="SectionHeader_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="SectionHeader_PreviewMouseMove">
                <Expander.Header>
                    <Border Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="10,6" HorizontalAlignment="Left"
                            BorderThickness="0" BorderBrush="Transparent" Tag="{Binding}"
                            AllowDrop="True" Drop="SectionHeader_Drop"
                            DragEnter="SectionHeader_DragEnter" DragLeave="SectionHeader_DragLeave"
                            MouseRightButtonUp="SectionHeader_RightClick">
                    <DockPanel>
                        <Border Width="18" Height="18" CornerRadius="9" DockPanel.Dock="Left" Margin="4,0,4,0"
                                Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding IconUrl, Converter={StaticResource UriToBitmapImageConverter}}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>

                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center" DockPanel.Dock="Left" Margin="4,0,0,0"/>

                        <ItemsControl ItemsSource="{Binding OnlineUsers}" DockPanel.Dock="Left" Margin="10,0,0,0"
                                      Visibility="{Binding IsShared, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="18" Height="18" CornerRadius="9" Margin="0,0,3,0"
                                            BorderBrush="#4CAF50" BorderThickness="2" ToolTip="{Binding Username}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding AvatarUrl, Converter={StaticResource UriToBitmapImageConverter}}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,0,0,0">
                            <!-- Tri, sections de guilde uniquement : seules vouées à devenir vraiment
                                 longues (catalogue d'un serveur entier), les autres restent des sélections
                                 courtes et manuelles où un tri n'apporterait rien. -->
                            <ComboBox Width="132" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"
                                      SelectionChanged="AllSoundsSort_SelectionChanged" Loaded="AllSoundsSortCombo_Loaded"
                                      Visibility="{Binding IsAllSounds, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ComboBoxItem Content="Ordre personnalisé" Tag="Custom"/>
                                <ComboBoxItem Content="Nom (A → Z)" Tag="NameAsc"/>
                                <ComboBoxItem Content="Nom (Z → A)" Tag="NameDesc"/>
                            </ComboBox>
                            <!-- Marqueur purement visuel (pas de handler propre) : la barre entière reste
                                 déplaçable via SectionHeader_PreviewMouseMove, ce repère indique juste que
                                 c'est possible, à la place des anciennes flèches ↑/↓. -->
                            <TextBlock Text="⠿" FontSize="14" Opacity="0.35" Margin="0,0,8,0" VerticalAlignment="Center"
                                       Cursor="SizeAll" ToolTip="Glisser pour réordonner"
                                       Foreground="{DynamicResource TextBrush}"
                                       Visibility="{Binding IsReorderable, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsManageable, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button Content="✎" Width="22" Height="20" Margin="2,0" FontSize="10"
                                        Click="RenameCategory_Click" Tag="{Binding}"
                                        Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0"/>
                                <Button Content="🗑" Width="22" Height="20" Margin="2,0" FontSize="10"
                                        Click="DeleteCategory_Click" Tag="{Binding}"
                                        Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                    </Border>
                </Expander.Header>

                <Border Background="{DynamicResource BgBrush}" CornerRadius="6" Padding="6" MinHeight="40"
                        AllowDrop="True" Drop="Section_Drop" Tag="{Binding}">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Sounds}" ItemTemplateSelector="{StaticResource SoundButtonTemplateSelector}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><local:AnimatedWrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Text="Glissez un son ici pour l'ajouter" FontSize="11" Opacity="0.5"
                                   Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Border>
            </Expander>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootChromeBorder" CornerRadius="8" Background="{DynamicResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <chrome:TitleBarControl x:Name="ChromeTitleBar" Grid.Row="0" TitleText="WaseBoard" ShowMinMax="True"/>

        <!-- "Now playing" (thème classique) : qui joue quoi en ce moment, dérivé du même sondage d'activité que
             le highlight des boutons (aucun appel réseau supplémentaire). Barre fixe (hauteur stable). Deux
             colonnes — la liste (rognée si trop longue) et le statut serveur — pour qu'elles ne se superposent
             jamais. En thème moderne la barre disparaît : « En ce moment » et le statut vivent dans la barre
             latérale (voir ApplyTheme). -->
        <Border x:Name="TopStrip" Grid.Row="1" Background="{DynamicResource PanelBrush}" Padding="14,6" Height="40" ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" ClipToBounds="True" Margin="0,0,12,0">
                    <ItemsControl ItemsSource="{Binding NowPlayingEntries, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Visibility="{Binding NowPlayingEntries.Count, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CountToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Background="{DynamicResource BgBrush}" Padding="8,4" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="18" Height="18" CornerRadius="9" Margin="0,0,6,0"
                                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding AvatarUrl, Converter={StaticResource UriToBitmapImageConverter}}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center">
                                            <Run Text="{Binding Username, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text=" joue "/>
                                            <InlineUIContainer BaselineAlignment="Center">
                                                <Image Source="{Binding Emoji, Mode=OneWay, Converter={StaticResource EmojiToImageSourceConverter}}"
                                                       Width="13" Height="13"/>
                                            </InlineUIContainer>
                                            <Run Text=" "/>
                                            <Run Text="{Binding SoundName, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Rien ne joue actuellement" FontSize="11" Opacity="0.5"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                               Visibility="{Binding NowPlayingEntries.Count, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}"/>
                </Grid>

                <!-- Statut serveur ("Connecté — X son(s)"). Déplacé dans la barre latérale en thème moderne
                     (StatusPanel est alors rattaché à SidebarStatusHost, voir PlaceStatusPanel). -->
                <Grid x:Name="StripStatusHost" Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel x:Name="StatusPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="2,0,6,0" VerticalAlignment="Center">
                            <Ellipse.RenderTransform>
                                <ScaleTransform CenterX="4" CenterY="4"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Resources>
                                <Storyboard x:Key="StatusDotPulse" RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.6">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseInOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </Ellipse.Resources>
                        </Ellipse>
                        <TextBlock x:Name="ServerStatusText" Text="" FontSize="12" Opacity="0.7"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

    <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="0"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Barre latérale (thème moderne uniquement), épurée : titre, [Accueil | Favoris] sur une ligne, groupes
             repliables « Serveurs » (peu nombreux, donc en premier) et « Catégories » (zone qui défile s'il y en a beaucoup), « En ce moment » toujours
             visible sous la navigation (sa hauteur n'est jamais cédée à la liste), pied compact sur 3 lignes. -->
        <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource PanelBrush}" Visibility="Collapsed">
            <Grid Margin="10,8,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button x:Name="SidebarToggleButton" DockPanel.Dock="Right" Content="◀" Width="28" Height="28" FontSize="12" FontWeight="Bold"
                            Click="SidebarToggle_Click" ToolTip="Réduire/agrandir la barre latérale" Cursor="Hand"
                            Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0"/>
                    <StackPanel x:Name="SidebarHeaderText" VerticalAlignment="Center">
                        <TextBlock x:Name="SidebarHeaderTitle" Text="🎛️ WaseBoard" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </DockPanel>

                <!-- Membres en vocal avec vous : visible seulement s'il y en a (toujours visible, même barre réduite).
                     L'avatar de celui/celle qui joue un son s'illumine en même temps que le bouton. -->
                <ItemsControl Grid.Row="1" Margin="0,0,0,8" ToolTip="En vocal avec vous"
                              ItemsSource="{Binding VoiceChannelMembers, RelativeSource={RelativeSource AncestorType=Window}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="26" Height="26" CornerRadius="13" Margin="0,0,5,5"
                                    BorderThickness="2" ToolTip="{Binding Username}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="White" BlurRadius="10" ShadowDepth="0" Opacity="0.55"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding AvatarUrl, Converter={StaticResource UriToBitmapImageConverter}}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid x:Name="SidebarBody" Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="48"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Accueil et Favoris côte à côte -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="🏠 Accueil" Click="NavHome_Click" Height="28" FontSize="12"
                                ToolTip="Revenir en haut de la liste"
                                Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}" BorderThickness="0"/>
                        <Button Grid.Column="2" Content="★ Favoris" Click="NavFavorites_Click" Height="28" FontSize="12"
                                ToolTip="Aller aux favoris"
                                Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0"/>
                    </Grid>

                    <!-- Groupes repliables : la zone défile quand il y a beaucoup de catégories/serveurs -->
                    <ScrollViewer x:Name="SidebarNavScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel x:Name="NavServersGroup">
                                <ToggleButton x:Name="NavServersToggle" Style="{StaticResource SidebarGroupHeaderStyle}"
                                              Checked="NavGroupToggle_Changed" Unchecked="NavGroupToggle_Changed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Serveurs" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="NavServersCount" Margin="6,0,0,0" Opacity="0.5"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ItemsControl x:Name="SidebarServersList" ItemTemplate="{StaticResource SidebarNavItemTemplate}"
                                              Visibility="{Binding IsChecked, ElementName=NavServersToggle, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                            <StackPanel x:Name="NavCategoriesGroup">
                                <ToggleButton x:Name="NavCategoriesToggle" Style="{StaticResource SidebarGroupHeaderStyle}"
                                              Checked="NavGroupToggle_Changed" Unchecked="NavGroupToggle_Changed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Catégories" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="NavCategoriesCount" Margin="6,0,0,0" Opacity="0.5"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ItemsControl x:Name="SidebarCategoriesList" ItemTemplate="{StaticResource SidebarNavItemTemplate}"
                                              Visibility="{Binding IsChecked, ElementName=NavCategoriesToggle, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- « En ce moment » : ligne à hauteur propre (jamais rognée par la liste de navigation) -->
                    <Grid Grid.Row="2" Margin="0,8,0,0" MaxHeight="150">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="🎧 En ce moment" FontSize="10" Opacity="0.5"
                                   Foreground="{DynamicResource TextBrush}" Margin="2,0,0,4"/>
                        <TextBlock Grid.Row="1" Text="Rien ne joue actuellement" FontSize="11" Opacity="0.45"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Top" Margin="2,0,0,0"
                                   Visibility="{Binding NowPlayingEntries.Count, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding NowPlayingEntries, RelativeSource={RelativeSource AncestorType=Window}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Background="{DynamicResource BgBrush}" Padding="6,4" Margin="0,0,0,4">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="20" Height="20" CornerRadius="10" Margin="0,0,7,0" VerticalAlignment="Top"
                                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding AvatarUrl, Converter={StaticResource UriToBitmapImageConverter}}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center">
                                                    <Run Text="{Binding Username, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    <Run Text=" joue "/>
                                                    <InlineUIContainer BaselineAlignment="Center">
                                                        <Image Source="{Binding Emoji, Mode=OneWay, Converter={StaticResource EmojiToImageSourceConverter}}"
                                                               Width="13" Height="13"/>
                                                    </InlineUIContainer>
                                                    <Run Text=" "/>
                                                    <Run Text="{Binding SoundName, Mode=OneWay}"/>
                                                </TextBlock>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Pied compact : statut serveur, statut vocal (une ligne, détail en infobulle), volume + paramètres -->
                    <Border x:Name="SidebarFooter" Grid.Row="3" Margin="0,8,0,0" Padding="2,8,2,0"
                            BorderBrush="{DynamicResource TrackBrush}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <Grid x:Name="SidebarStatusHost" Margin="0,0,0,2"/>
                            <TextBlock x:Name="SidebarConnectionText" Text="🔴 Non connecté" FontSize="11" Opacity="0.75"
                                       Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Équivalent du slider de la barre d'outils classique (MainVolumePanel), qui
                                     reste masqué en thème moderne pour ne pas le dupliquer — voir ApplyTheme(). -->
                                <TextBlock Grid.Column="0" Text="🔊" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextBrush}"/>
                                <Slider x:Name="SidebarVolumeSlider" Grid.Column="1" Minimum="0" Maximum="1.5" Value="1.0"
                                        ValueChanged="VolumeSlider_ValueChanged" ToolTip="Volume d'écoute local (aperçu uniquement, jamais envoyé à Discord)"/>
                                <TextBlock x:Name="SidebarVolumeLabel" Grid.Column="2" Text="100%" FontSize="10" Opacity="0.7" Width="30"
                                           TextAlignment="Right" VerticalAlignment="Center" Margin="4,0,6,0" Foreground="{DynamicResource TextBrush}"/>
                                <Button Grid.Column="3" Content="⚙" Click="SettingsButton_Click" Width="28" Height="28" ToolTip="Paramètres"
                                        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Contenu principal -->
        <Grid Grid.Column="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barre unique : titre (classique), recherche, volume (classique), actions. Quatre colonnes
                 (la recherche prend le reste, jamais moins de 150 px) : les éléments ne peuvent plus se
                 chevaucher ni écraser la recherche. Les libellés des boutons se raccourcissent quand la
                 fenêtre est étroite (ApplyToolbarDensity). Paramètres et volume ne restent visibles ICI
                 qu'en thème classique (la barre latérale les porte en moderne) — voir ApplyTheme(). -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TitleText" Grid.Column="0" Text="🎛️ WaseBoard" FontSize="18" FontWeight="Bold" Margin="0,0,12,0"
                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>

                <Grid Grid.Column="1" Margin="0,0,12,0" HorizontalAlignment="Stretch" MaxWidth="420">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextBrush}"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Height="28" HorizontalAlignment="Stretch"
                             TextChanged="SearchBox_TextChanged"
                             ToolTip="Rechercher un son par son nom"/>
                </Grid>

                <StackPanel x:Name="MainVolumePanel" Grid.Column="2" Orientation="Horizontal"
                            Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="🔊" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextBrush}"/>
                    <Slider x:Name="MainVolumeSlider" Width="80" Minimum="0" Maximum="1.5" Value="1.0"
                            ValueChanged="VolumeSlider_ValueChanged" ToolTip="Volume d'écoute local (aperçu uniquement, jamais envoyé à Discord)"/>
                    <TextBlock x:Name="MainVolumeLabel" Text="100%" FontSize="11" Opacity="0.7" Width="34"
                               VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RefreshButton" Content="⟳" ToolTip="Actualiser le catalogue" Width="34" Height="30" Padding="0" Margin="0,0,6,0"
                            Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="1"
                            BorderBrush="{DynamicResource TextBrush}" Click="RefreshButton_Click"/>
                    <Button x:Name="JoinVoiceButton" Height="30" Padding="10,0" Margin="0,0,6,0"
                            Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="1"
                            BorderBrush="{DynamicResource TextBrush}" Click="JoinVoiceButton_Click"
                            ToolTip="Rejoindre mon vocal : fait rejoindre le bot au salon vocal où vous êtes actuellement">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔊"/>
                            <TextBlock x:Name="JoinVoiceLabel" Text=" Vocal"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopAllButton" Height="30" Padding="10,0" Margin="0,0,6,0"
                            Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="1"
                            BorderBrush="{DynamicResource TextBrush}" Click="StopAllButton_Click"
                            ToolTip="Stop tout : coupe les sons en cours">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏹"/>
                            <TextBlock x:Name="StopAllLabel" Text=" Stop"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton" Content="⚙" ToolTip="Paramètres" Width="34" Height="30" Padding="0" Margin="0,0,6,0"
                            Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="1"
                            BorderBrush="{DynamicResource TextBrush}" Click="SettingsButton_Click"/>
                    <Button x:Name="AddCategoryButton" Height="30" Padding="10,0" Margin="0,0,6,0"
                            Click="AddCategoryButton_Click" ToolTip="Nouvelle catégorie"
                            Background="Transparent" Foreground="{DynamicResource TextBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource TextBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+"/>
                            <TextBlock x:Name="AddCategoryLabel" Text=" Catégorie"/>
                            <TextBlock Text=" ▾"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AddSoundButton" Height="30" Padding="12,0"
                            Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}" BorderThickness="0"
                            Click="AddSoundButton_Click" ToolTip="Ajouter un son (ou glissez des fichiers audio dans la fenêtre)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+"/>
                            <TextBlock x:Name="AddSoundLabel" Text=" Ajouter un son"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Sections : ★ Favoris, catégories personnalisées, puis une par guilde Discord -->
            <ScrollViewer x:Name="SectionsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="SectionsItemsControl" ItemTemplate="{StaticResource SectionTemplate}"/>
            </ScrollViewer>

            <!-- Overlay affiché pendant le survol d'un glisser-déposer de fichiers -->
            <Border x:Name="DropOverlay" Grid.Row="0" Grid.RowSpan="2"
                    Background="#CC1E1E2E" CornerRadius="8"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock Text="⬇ Déposez vos fichiers audio ici" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Copie flottante d'un bouton de son pendant son glisser-déposer (voir ShowDragVisual/
                 Window_PreviewDragOver) : suit le curseur pour bien montrer que le son "voyage" vers
                 l'endroit du dépôt, plutôt que de laisser le bouton d'origine seul immobile. -->
            <Canvas x:Name="DragVisualCanvas" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False"/>
        </Grid>
    </Grid>

    <!-- Overlay de notifications (toasts), remplace les MessageBox.Show ponctuels -->
    <ItemsControl Grid.Row="2" ItemsSource="{Binding Toasts, RelativeSource={RelativeSource AncestorType=Window}}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="12,10"
                        Margin="0,6,0,0" MaxWidth="320" BorderThickness="0,0,0,3" BorderBrush="{Binding AccentColor}"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Opacity="0.35"/>
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TranslateTransform X="40"/>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                     To="0" Duration="0:0:0.25">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Icon}" Foreground="{Binding AccentColor}" FontSize="15"
                                   Margin="0,0,8,0" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextBrush}" FontSize="12"
                                   TextWrapping="Wrap" MaxWidth="250"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Palette de commande (Ctrl+K) : recherche + lancement d'un son sans scroller -->
    <Grid x:Name="CommandPaletteOverlay" Grid.Row="0" Grid.RowSpan="3" Background="#AA000000"
          Visibility="Collapsed" MouseLeftButtonDown="CommandPaletteOverlay_MouseLeftButtonDown">
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Width="440" MaxHeight="420"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,90,0,0" Padding="6"
                MouseLeftButtonDown="CommandPalettePanel_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="4" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel>
                <TextBox x:Name="CommandPaletteBox" Margin="6" FontSize="16" Height="34" Padding="8,4"
                         TextChanged="CommandPaletteBox_TextChanged" PreviewKeyDown="CommandPaletteBox_PreviewKeyDown"/>
                <ListBox x:Name="CommandPaletteList" MaxHeight="320" BorderThickness="0" Background="Transparent"
                         MouseDoubleClick="CommandPaletteList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="6,5">
                                <Image Source="{Binding Emoji, Converter={StaticResource EmojiToImageSourceConverter}}"
                                       Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="13"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
    </Border>
</Window>
