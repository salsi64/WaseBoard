<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Doit rester synchronisé avec MyAppVersion dans installer/setup.iss (source de vérité
         pour le numéro affiché par l'installeur ; celle-ci est lue à l'exécution pour le
         comparateur de mises à jour, UpdateCheckService). -->
    <Version>3.0.1</Version>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>WaseBoard</RootNamespace>
    <AssemblyName>WaseBoard</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Configurations>Debug;Release;Dev</Configurations>
  </PropertyGroup>

  <!-- Configuration "Dev" : build de test pointée vers le serveur/bot Discord isolés
       (feature/multi-tenant), avec sa propre identité (dossier AppData, mutex, titre, nom
       d'exe) pour ne jamais lire/écrire les réglages de l'installation WaseBoard normale et
       pouvoir tourner en même temps qu'elle (dotnet build -c Dev / dotnet run -c Dev). -->
  <PropertyGroup Condition="'$(Configuration)'=='Dev'">
    <DefineConstants>$(DefineConstants);WASEBOARD_DEV</DefineConstants>
    <AssemblyName>WaseBoard-Dev</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <!-- Index des emojis Fluent 3D (voir EmojiImageResolver). LogicalName : nom stable pour GetManifestResourceStream. -->
    <EmbeddedResource Include="Assets\fluent-emoji-index.txt" LogicalName="fluent-emoji-index.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Concentus.OggFile" Version="1.0.6" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
