# Configuration du serveur WaseBoard (Docker). `setup.sh` / `setup.ps1` écrivent ce fichier pour vous ;
# vous pouvez aussi le copier vers `.env` et le remplir à la main. Ne le partagez jamais : il contient des secrets.
# Une valeur laissée vide est ignorée.

# --- Obligatoire ---------------------------------------------------------------------------------------------
# Portail Discord > votre application > Bot > Reset Token
WASEBOARD_BOT_TOKEN=
# Portail Discord > OAuth2 > Reset Secret (le « Client ID » est déduit du bot)
WASEBOARD_OAUTH2_CLIENT_SECRET=
# Mot de passe long et aléatoire (32 caractères ou plus) : protège toute l'API. L'assistant en génère un.
WASEBOARD_SHARED_SECRET=
# Adresse par laquelle les clients WaseBoard joignent ce serveur (ex : https://waseboard.exemple.com)
WASEBOARD_PUBLIC_URL=

# --- Recommandé ----------------------------------------------------------------------------------------------
# Identifiant de VOTRE serveur Discord (mode développeur > clic droit > Copier l'ID) : les commandes /join, /leave...
# apparaissent aussitôt sur tous les serveurs du bot (sinon jusqu'à 1 h).
WASEBOARD_GUILD_ID=

# --- Réseau et HTTPS -----------------------------------------------------------------------------------------
# Profils actifs : `https` = Caddy (certificat automatique), `duckdns` = mise à jour d'un sous-domaine DuckDNS.
# Vide = le serveur seul (vous fournissez votre propre reverse proxy).
COMPOSE_PROFILES=
# Nom de domaine (profil https)
WASEBOARD_DOMAIN=
# Adresse d'écoute côté machine : 127.0.0.1 (par défaut, derrière Caddy ou votre proxy) ou 0.0.0.0 (réseau local, sans HTTPS)
WASEBOARD_BIND=127.0.0.1
WASEBOARD_PORT=5005
# Profil duckdns : sous-domaine (sans .duckdns.org) et jeton du compte
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

# --- Facultatif ----------------------------------------------------------------------------------------------
# Où télécharger WaseBoard (proposé sur la page d'invitation) ; par défaut la dernière version sur GitHub
WASEBOARD_DOWNLOAD_URL=
# Jours de conservation d'un son supprimé avant purge définitive (30 par défaut, 0 = jamais)
WASEBOARD_TRASH_RETENTION_DAYS=

# --- Capacité (facultatif ; vide ou 0 = désactivé) : voir « Capacité et exploitation » dans le README ------------
# Points de départ pour une machine de 6 cœurs / 11 Go :
# WASEBOARD_MAX_GUILDS=100
# WASEBOARD_MAX_CONCURRENT_VOICE=40
# WASEBOARD_MAX_SOURCES_PER_GUILD=8
# WASEBOARD_MAX_FFMPEG_PROCESSES=100
# WASEBOARD_HTTP_RATE_LIMIT_PER_MIN=60
# Valeurs de départ des nouveaux serveurs Discord / plafonds que leurs admins ne peuvent pas dépasser (objets JSON, sans espaces) :
# WASEBOARD_DEFAULT_GUILD_LIMITS={"max_sounds":300,"max_file_mb":20,"max_total_mb":500}
# WASEBOARD_GUILD_LIMIT_CEILINGS={"max_file_mb":50,"max_total_mb":2000}
